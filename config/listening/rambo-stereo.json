{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "source-pin",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "asset",
        "songs/rambo-loader.json",
        "--sha256",
        "3a59937b1e3c1c9b95872bc262330dfaa97649ef78f5a8ad3fa01cc47e3b809b",
        "--output",
        "{out}/source.json"
      ],
      "inputs": [
        "songs/rambo-loader.json",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "source.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "faithful-pin",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "asset",
        "samples/rambo-loader/rambo-loader.sid",
        "--sha256",
        "9a6901e656f4de1888f9acc71c80abaf3608b9758b559b306b0b8b6eaa64aecd",
        "--output",
        "{out}/faithful.json"
      ],
      "inputs": [
        "samples/rambo-loader/rambo-loader.sid",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "faithful.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "focused-guards",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "rambo_stereo*_test.py",
        "-v"
      ],
      "inputs": [
        "songs/rambo-loader.json",
        "scripts/compose-rambo.py",
        "scripts/rambo_player.py",
        "scripts/rambo_score.py",
        "scripts/rambo_programs.py",
        "scripts/verify_player.py",
        "scripts/sid_assembler.py",
        "songs/players/rambo.asm",
        "songs/players/rambo-sound.asm",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        ".tools/test-deps/py65",
        "tests/rambo_stereo_compiler_test.py",
        "tests/rambo_compiler_test.py",
        "tests/rambo_stereo_listening_test.py",
        "scripts/studies/rambo/prepare-stereo-listening.py",
        "scripts/audio_comparison.py",
        "samples/rambo-loader/rambo-loader.sid"
      ],
      "outputs": [],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-build",
      "command": [
        "{python}",
        "scripts/compose-rambo.py",
        "songs/rambo-loader.json",
        "--stereo-bass",
        "--calls",
        "11000",
        "--output",
        "{out}/candidate"
      ],
      "inputs": [
        "songs/rambo-loader.json",
        "scripts/compose-rambo.py",
        "scripts/rambo_player.py",
        "scripts/rambo_score.py",
        "scripts/rambo_programs.py",
        "scripts/verify_player.py",
        "scripts/sid_assembler.py",
        "songs/players/rambo.asm",
        "songs/players/rambo-sound.asm",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        ".tools/test-deps/py65"
      ],
      "outputs": [
        "candidate/reconstructed.sid",
        "candidate/build.json",
        "candidate/audit.json",
        "candidate/writes.json",
        "candidate/state-checkpoints.json",
        "candidate/player.asm",
        "candidate/player.listing"
      ],
      "timeoutSeconds": 600,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-vice",
      "command": [
        "{python}",
        "scripts/trace-sid-vice.py",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "--oracle",
        "{stage:candidate-build}/candidate/writes.json",
        "--first-call",
        "0",
        "--last-call",
        "10999",
        "--timeout",
        "300",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--output",
        "{out}/vice",
        "--profile",
        "pal-banked",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{stage:candidate-build}/candidate/writes.json",
        "scripts/trace-sid-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        "scripts/sid_clock.py",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib"
      ],
      "outputs": [
        "vice/study.json",
        "vice/trace.json",
        "vice/monitor.log",
        "vice/command.json",
        "vice/commands.mon"
      ],
      "timeoutSeconds": 330,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "faithful-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "samples/rambo-loader/rambo-loader.sid",
        "{out}/render.wav",
        "225",
        "--clock",
        "pal",
        "--subtune",
        "1"
      ],
      "inputs": [
        "samples/rambo-loader/rambo-loader.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "225",
        "--clock",
        "pal",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "prepare",
      "command": [
        "{python}",
        "scripts/studies/rambo/prepare-stereo-listening.py",
        "--faithful",
        "{stage:faithful-render}/render.wav",
        "--candidate",
        "{stage:candidate-render}/render.wav",
        "--output",
        "{out}/prepared"
      ],
      "inputs": [
        "scripts/studies/rambo/prepare-stereo-listening.py",
        "scripts/audio_comparison.py",
        "{stage:faithful-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "scripts/verify_player.py"
      ],
      "outputs": [
        "prepared/faithful-dual-mono.wav",
        "prepared/stereo-mono-sum.wav",
        "prepared/faithful-phrase.wav",
        "prepared/stereo-phrase.wav",
        "prepared/faithful-ending.wav",
        "prepared/stereo-ending.wav",
        "prepared/signal.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "phrase-comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "prepare",
        "{stage:prepare}/prepared/faithful-phrase.wav",
        "{stage:prepare}/prepared/stereo-phrase.wav",
        "{out}/faithful-then-stereo-phrase",
        "--individual-copies",
        "--gap-seconds",
        "0.5"
      ],
      "inputs": [
        "{stage:prepare}/prepared/faithful-phrase.wav",
        "{stage:prepare}/prepared/stereo-phrase.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "faithful-then-stereo-phrase.ab.wav",
        "faithful-then-stereo-phrase.comparison.json",
        "faithful-then-stereo-phrase.a.matched.wav",
        "faithful-then-stereo-phrase.b.matched.wav"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "ending-comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "prepare",
        "{stage:prepare}/prepared/faithful-ending.wav",
        "{stage:prepare}/prepared/stereo-ending.wav",
        "{out}/faithful-then-stereo-ending",
        "--individual-copies",
        "--gap-seconds",
        "0.5"
      ],
      "inputs": [
        "{stage:prepare}/prepared/faithful-ending.wav",
        "{stage:prepare}/prepared/stereo-ending.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "faithful-then-stereo-ending.ab.wav",
        "faithful-then-stereo-ending.comparison.json",
        "faithful-then-stereo-ending.a.matched.wav",
        "faithful-then-stereo-ending.b.matched.wav"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "deliverables": {
    "fullFaithful": "{stage:prepare}/prepared/faithful-dual-mono.wav",
    "fullCandidate": "{stage:candidate-render}/render.wav",
    "phraseComparison": "{stage:phrase-comparison}/faithful-then-stereo-phrase.ab.wav",
    "endingComparison": "{stage:ending-comparison}/faithful-then-stereo-ending.ab.wav",
    "monoSumDiagnostic": "{stage:prepare}/prepared/stereo-mono-sum.wav",
    "fullFaithfulMono": "{stage:faithful-render}/render.wav",
    "matchedFaithfulPhrase": "{stage:phrase-comparison}/faithful-then-stereo-phrase.a.matched.wav",
    "matchedStereoPhrase": "{stage:phrase-comparison}/faithful-then-stereo-phrase.b.matched.wav",
    "audioHealth": "{stage:prepare}/prepared/signal.json",
    "candidateSid": "{stage:candidate-build}/candidate/reconstructed.sid",
    "candidateBuild": "{stage:candidate-build}/candidate/build.json",
    "candidateAudit": "{stage:candidate-build}/candidate/audit.json",
    "candidateVice": "{stage:candidate-vice}/vice/study.json"
  }
}
