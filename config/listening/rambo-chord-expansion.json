{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "source-pin",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "asset",
        "songs/rambo-loader.json",
        "--sha256",
        "3a59937b1e3c1c9b95872bc262330dfaa97649ef78f5a8ad3fa01cc47e3b809b",
        "--output",
        "{out}/source.json"
      ],
      "inputs": [
        "songs/rambo-loader.json",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "source.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "previous-pin",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "asset",
        "build/rambo-ensemble-listening/ensemble-raw-chips-full.wav",
        "--sha256",
        "178d08860bddc06520a5c374b0badaf86e43dcad571e9388dbf545280843757f",
        "--output",
        "{out}/previous.json"
      ],
      "inputs": [
        "build/rambo-ensemble-listening/ensemble-raw-chips-full.wav",
        "build/rambo-ensemble-listening/sources.json",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "previous.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "chord-focused-guards",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "rambo_chord_expansion*_test.py",
        "-v"
      ],
      "inputs": [
        "scripts/studies/rambo/prepare-ensemble.py",
        "songs/studies/rambo-chord-expansion/arrangement.json",
        "songs/rambo-loader.json",
        "scripts/rambo_player.py",
        "scripts/rambo_programs.py",
        "scripts/rambo_score.py",
        "scripts/verify_player.py",
        "songs/studies/rambo-ensemble/arrangement.json",
        "scripts/studies/rambo/prepare-chord-expansion-listening.py",
        "scripts/audio_comparison.py",
        "tests/rambo_chord_expansion_test.py",
        "tests/rambo_chord_expansion_listening_test.py",
        "tests/rambo_ensemble_test.py",
        "scripts/sid_clock.py"
      ],
      "outputs": [],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "compiler-focused-guards",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "rambo_dual_compiler_test.py",
        "-v"
      ],
      "inputs": [
        "songs/rambo-loader.json",
        "scripts/compose-rambo.py",
        "scripts/rambo_player.py",
        "scripts/rambo_score.py",
        "scripts/rambo_programs.py",
        "scripts/verify_player.py",
        "scripts/sid_assembler.py",
        "songs/players/rambo.asm",
        "songs/players/rambo-sound.asm",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        ".tools/test-deps/py65",
        "scripts/compose-rambo-dual.py",
        "tests/rambo_dual_compiler_test.py",
        "tests/rambo_compiler_test.py"
      ],
      "outputs": [],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "prepare-score",
      "command": [
        "{python}",
        "scripts/studies/rambo/prepare-ensemble.py",
        "songs/studies/rambo-chord-expansion/arrangement.json",
        "--output",
        "{out}/prepared"
      ],
      "inputs": [
        "scripts/studies/rambo/prepare-ensemble.py",
        "songs/studies/rambo-chord-expansion/arrangement.json",
        "songs/rambo-loader.json",
        "scripts/rambo_player.py",
        "scripts/rambo_programs.py",
        "scripts/rambo_score.py",
        "scripts/verify_player.py"
      ],
      "outputs": [
        "prepared/secondary.json",
        "prepared/arrangement-proof.json",
        "prepared/source-note-events.json.gz",
        "prepared/support-note-events.json.gz"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-build",
      "command": [
        "{python}",
        "scripts/compose-rambo-dual.py",
        "songs/rambo-loader.json",
        "{stage:prepare-score}/prepared/secondary.json",
        "--calls",
        "11000",
        "--output",
        "{out}/candidate"
      ],
      "inputs": [
        "songs/rambo-loader.json",
        "scripts/compose-rambo.py",
        "scripts/rambo_player.py",
        "scripts/rambo_score.py",
        "scripts/rambo_programs.py",
        "scripts/verify_player.py",
        "scripts/sid_assembler.py",
        "songs/players/rambo.asm",
        "songs/players/rambo-sound.asm",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        ".tools/test-deps/py65",
        "scripts/compose-rambo-dual.py",
        "{stage:prepare-score}/prepared/secondary.json"
      ],
      "outputs": [
        "candidate/reconstructed.sid",
        "candidate/build.json",
        "candidate/audit.json",
        "candidate/writes.json",
        "candidate/state-checkpoints.json",
        "candidate/wrapper.asm",
        "candidate/wrapper.listing",
        "candidate/primary.asm",
        "candidate/primary.listing",
        "candidate/secondary.asm",
        "candidate/secondary.listing"
      ],
      "timeoutSeconds": 600,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-vice",
      "command": [
        "{python}",
        "scripts/trace-sid-vice.py",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "--oracle",
        "{stage:candidate-build}/candidate/writes.json",
        "--first-call",
        "0",
        "--last-call",
        "10999",
        "--timeout",
        "300",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--output",
        "{out}/vice",
        "--profile",
        "pal-banked",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{stage:candidate-build}/candidate/writes.json",
        "scripts/trace-sid-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        "scripts/sid_clock.py",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib"
      ],
      "outputs": [
        "vice/study.json",
        "vice/trace.json",
        "vice/monitor.log",
        "vice/command.json",
        "vice/commands.mon"
      ],
      "timeoutSeconds": 330,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "timing-focused-guards",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "rambo_chord_timing_test.py",
        "-v"
      ],
      "inputs": [
        "scripts/studies/rambo/check-chord-expansion-timing.py",
        "tests/rambo_chord_timing_test.py"
      ],
      "outputs": [],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "timing-comparison",
      "command": [
        "{python}",
        "scripts/studies/rambo/check-chord-expansion-timing.py",
        "--reference-build",
        "evidence/rambo-ensemble/cpu/build.json",
        "--reference-writes",
        "evidence/rambo-ensemble/cpu/writes.json.gz",
        "--reference-study",
        "evidence/rambo-ensemble/vice/study.json",
        "--reference-trace",
        "evidence/rambo-ensemble/vice/trace.json.gz",
        "--candidate-build",
        "{stage:candidate-build}/candidate/build.json",
        "--candidate-writes",
        "{stage:candidate-build}/candidate/writes.json",
        "--candidate-study",
        "{stage:candidate-vice}/vice/study.json",
        "--candidate-trace",
        "{stage:candidate-vice}/vice/trace.json",
        "--candidate-sid",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "--primary-reference",
        "samples/rambo-loader/rambo-loader.sid",
        "--output",
        "{out}/timing"
      ],
      "inputs": [
        "scripts/studies/rambo/check-chord-expansion-timing.py",
        "evidence/rambo-ensemble/cpu/build.json",
        "evidence/rambo-ensemble/cpu/writes.json.gz",
        "evidence/rambo-ensemble/vice/study.json",
        "evidence/rambo-ensemble/vice/trace.json.gz",
        "{stage:candidate-build}/candidate/build.json",
        "{stage:candidate-build}/candidate/writes.json",
        "{stage:candidate-vice}/vice/study.json",
        "{stage:candidate-vice}/vice/trace.json",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "samples/rambo-loader/rambo-loader.sid"
      ],
      "outputs": [
        "timing/timing-proof.json",
        "timing/timing-deltas.json.gz"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "225",
        "--clock",
        "pal",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "support-build",
      "command": [
        "{python}",
        "scripts/compose-rambo.py",
        "{stage:prepare-score}/prepared/secondary.json",
        "--calls",
        "5300",
        "--output",
        "{out}/support"
      ],
      "inputs": [
        "scripts/compose-rambo.py",
        "scripts/rambo_player.py",
        "scripts/rambo_score.py",
        "scripts/rambo_programs.py",
        "scripts/verify_player.py",
        "scripts/sid_assembler.py",
        "songs/players/rambo.asm",
        "songs/players/rambo-sound.asm",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        ".tools/test-deps/py65",
        "{stage:prepare-score}/prepared/secondary.json"
      ],
      "outputs": [
        "support/reconstructed.sid",
        "support/build.json",
        "support/audit.json",
        "support/writes.json",
        "support/state-checkpoints.json",
        "support/player.asm",
        "support/player.listing"
      ],
      "timeoutSeconds": 600,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "support-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:support-build}/support/reconstructed.sid",
        "{out}/render.wav",
        "104",
        "--clock",
        "pal",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:support-build}/support/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "support-without-3",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:support-build}/support/reconstructed.sid",
        "{out}/render.wav",
        "104",
        "--clock",
        "pal",
        "--subtune",
        "1",
        "--voices",
        "1,2"
      ],
      "inputs": [
        "{stage:support-build}/support/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "prepare-listening",
      "command": [
        "{python}",
        "scripts/studies/rambo/prepare-chord-expansion-listening.py",
        "--previous",
        "build/rambo-ensemble-listening/ensemble-raw-chips-full.wav",
        "--expanded",
        "{stage:candidate-render}/render.wav",
        "--support",
        "{stage:support-render}/render.wav",
        "--omitted",
        "{stage:support-without-3}/render.wav",
        "--timing",
        "{stage:timing-comparison}/timing/timing-proof.json",
        "--output",
        "{out}/prepared"
      ],
      "inputs": [
        "scripts/studies/rambo/prepare-chord-expansion-listening.py",
        "scripts/audio_comparison.py",
        "scripts/verify_player.py",
        "build/rambo-ensemble-listening/ensemble-raw-chips-full.wav",
        "{stage:candidate-render}/render.wav",
        "{stage:support-render}/render.wav",
        "{stage:support-without-3}/render.wav",
        "{stage:timing-comparison}/timing/timing-proof.json",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "prepared/previous-raw-full.wav",
        "prepared/previous-raw-phrase.wav",
        "prepared/expanded-raw-phrase.wav",
        "prepared/audio.json",
        "prepared/expanded-mono-diagnostic.wav"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "phrase-comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "prepare",
        "{stage:prepare-listening}/prepared/previous-raw-phrase.wav",
        "{stage:prepare-listening}/prepared/expanded-raw-phrase.wav",
        "{out}/prior-raw-then-expanded-chord-phrase",
        "--individual-copies",
        "--gap-seconds",
        "0.5"
      ],
      "inputs": [
        "{stage:prepare-listening}/prepared/previous-raw-phrase.wav",
        "{stage:prepare-listening}/prepared/expanded-raw-phrase.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "prior-raw-then-expanded-chord-phrase.ab.wav",
        "prior-raw-then-expanded-chord-phrase.comparison.json",
        "prior-raw-then-expanded-chord-phrase.a.matched.wav",
        "prior-raw-then-expanded-chord-phrase.b.matched.wav"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "deliverables": {
    "fullPrevious": "{stage:prepare-listening}/prepared/previous-raw-full.wav",
    "fullCandidate": "{stage:candidate-render}/render.wav",
    "phraseComparison": "{stage:phrase-comparison}/prior-raw-then-expanded-chord-phrase.ab.wav",
    "audioHealth": "{stage:prepare-listening}/prepared/audio.json",
    "arrangementProof": "{stage:prepare-score}/prepared/arrangement-proof.json",
    "secondaryDescription": "{stage:prepare-score}/prepared/secondary.json",
    "candidateSid": "{stage:candidate-build}/candidate/reconstructed.sid",
    "candidateBuild": "{stage:candidate-build}/candidate/build.json",
    "candidateAudit": "{stage:candidate-build}/candidate/audit.json",
    "candidateVice": "{stage:candidate-vice}/vice/study.json",
    "supportPrefixBuild": "{stage:support-build}/support/build.json",
    "timingProof": "{stage:timing-comparison}/timing/timing-proof.json",
    "timingDeltas": "{stage:timing-comparison}/timing/timing-deltas.json.gz",
    "monoDiagnostic": "{stage:prepare-listening}/prepared/expanded-mono-diagnostic.wav"
  }
}
