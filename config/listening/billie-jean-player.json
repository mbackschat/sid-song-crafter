{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "player-guards",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "billie_jean_player_test.py",
        "-v"
      ],
      "inputs": [
        "tests/billie_jean_player_test.py",
        "scripts/studies/billie-jean/billie_jean_player.py",
        "scripts/studies/billie-jean/billie_jean_programs.py",
        "scripts/studies/billie-jean/billie_jean_score.py"
      ],
      "outputs": [],
      "timeoutSeconds": 30,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "player-proof",
      "command": [
        "{python}",
        "scripts/studies/billie-jean/check-player.py",
        "--output",
        "{out}/proof"
      ],
      "inputs": [
        ".local/research/billie-jean/Billie_Jean.sid",
        "evidence/manifest.json",
        "evidence/billie-jean-form",
        "evidence/billie-jean-score",
        "evidence/billie-jean-sound",
        "scripts/evidence.py",
        "scripts/studies/billie-jean/check-player.py",
        "scripts/studies/billie-jean/billie_jean_player.py",
        "scripts/studies/billie-jean/billie_jean_programs.py",
        "scripts/studies/billie-jean/billie_jean_score.py"
      ],
      "outputs": [
        "proof/composition.json",
        "proof/writes.json",
        "proof/returns.json",
        "proof/contexts.json",
        "proof/receipt.json"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "deliverables": {
    "composition": "{stage:player-proof}/proof/composition.json",
    "playerProof": "{stage:player-proof}/proof/receipt.json"
  }
}
