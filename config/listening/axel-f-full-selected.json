      "id": "original",
      "command": [
        "{python}",
        "-c",
        "import hashlib,json,pathlib,shutil,sys\nbaseline,output=map(pathlib.Path,sys.argv[1:])\nnames=(('native-song.wav','native-song.wav'),('native-song.frames.json','native-song.frames.json'),('native-song.writes.json','native-song.writes.json'),('conversion.json','conversion.json'),('verification.json','verification.json'),('export/candidate.sid','export/reference.sid'))\nerrors=[];selected=None\nfor receipt_name in ('completed-run.json','run.json'):\n    try:\n        receipt_path=baseline/receipt_name\n        receipt=json.loads(receipt_path.read_text())\n        if receipt['status']!='completed':raise ValueError('receipt is not completed')\n        stages=[item for item in receipt['stages'] if item['id']=='candidate' and item['status'] in ('completed','reused')]\n        if len(stages)!=1:raise ValueError('expected one successful candidate stage')\n        stage=stages[0]\n        source=baseline/'cache'/'candidate'/stage['cacheKey']/pathlib.Path(stage['attemptDirectory']).name/'song'\n        if not source.resolve().is_relative_to((baseline/'cache'/'candidate').resolve()):raise ValueError('candidate artifact path leaves the baseline cache')\n        artifacts=[]\n        for name,destination in names:\n            path=source/name\n            matches=[item for item in receipt['artifacts'] if item['stageId']=='candidate' and item['relativePath']=='song/'+name]\n            if len(matches)!=1 or path.is_symlink() or hashlib.sha256(path.read_bytes()).hexdigest()!=matches[0]['sha256']:raise ValueError('artifact differs from receipt: '+name)\n            artifacts.append((path,destination,matches[0]['sha256']))\n        if artifacts[0][2]!='e5698fc525b4f884ffe4b8fdab26e929e585a4c199c0baa82dd0d59866b13154':raise ValueError('receipt does not describe the frozen tonal full WAV')\n        verification=json.loads((source/'verification.json').read_text())\n        if verification['pcm']['sha256']!=artifacts[0][2] or verification['audit']['sourceSha256']!=artifacts[-1][2]:raise ValueError('Baseline full-render verification does not bind this WAV and SID')\n        sidecar=source/'native-song.wav.registers.tsv'\n        if sidecar.is_symlink() or not sidecar.is_file():raise ValueError('Baseline full-render snapshot sidecar is missing')\n        artifacts.append((sidecar,'native-song.wav.registers.tsv',hashlib.sha256(sidecar.read_bytes()).hexdigest()))\n        selected=(receipt_name,receipt_path,receipt,artifacts);break\n    except (OSError,ValueError,KeyError,TypeError) as error:errors.append(receipt_name+': '+str(error))\nif selected is None:raise ValueError('No intact completed baseline receipt: '+str(errors)+'. Restore its declared inputs, then run python3 scripts/listening-package.py config/listening/axel-f-full-master-palette.json --output build/axel-f-full-master-palette')\nreceipt_name,receipt_path,receipt,artifacts=selected\noutput.mkdir();reports=[]\nfor source,destination,digest in artifacts:\n    target=output/destination;target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(source,target)\n    if hashlib.sha256(target.read_bytes()).hexdigest()!=digest:raise ValueError('Copied baseline artifact differs: '+destination)\n    reports.append(dict(sourcePath=str(source),destination=destination,sha256=digest))\nshutil.copyfile(receipt_path,output/'reference-input-receipt.json')\n(output/'reference-reuse.json').write_text(json.dumps(dict(schemaVersion=1,sourceReceipt=str(receipt_path),selectedReceiptName=receipt_name,sourceReceiptSha256=hashlib.sha256(receipt_path.read_bytes()).hexdigest(),files=reports,earlierReceiptFailures=errors,freshBaselineRender=False,fullRenderSnapshotSidecarPinnedAtImport=True,fullRenderSnapshotSidecarOriginallyDeclaredInReceipt=False,scope='Receipt-driven reuse. Candidate cache key and attempt directory come from the completed receipt, so a regenerated baseline needs no hardcoded UUID. The whole baseline directory is a declared input, including every source artifact.'),indent=2)+chr(10))\n",
        "build/axel-f-full-master-palette",
        "{out}/song"
      ],
