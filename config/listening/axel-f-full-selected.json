        "import json,pathlib,subprocess,sys\nseconds=json.loads(pathlib.Path(sys.argv[1]).read_text())[\"pcm\"][\"durationSeconds\"]\nfor name,sid in zip((\"reference\",\"candidate\"),sys.argv[3:5]):\n subprocess.run([sys.argv[2],sid,str(pathlib.Path(sys.argv[5])/(name+\"-harmony.wav\")),str(seconds),\"--voices\",\"2\",\"--clock\",\"pal\"],check=True,timeout=60)\n",
        "{stage:reference}/song/verification.json",
        ".local/bin/render-sid",
        "{stage:reference}/song/export/reference.sid",
        "{stage:candidate}/song/export/candidate.sid",
        "{out}"
      ],
      "inputs": [
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a",
        "{stage:reference}/song/verification.json",
        "{stage:reference}/song/export/reference.sid",
        "{stage:candidate}/song/export/candidate.sid"
      ],
      "outputs": [
        "reference-harmony.wav",
        "reference-harmony.wav.registers.tsv",
        "candidate-harmony.wav",
        "candidate-harmony.wav.registers.tsv"
      ],
      "timeoutSeconds": 120
    },
    {
      "id": "full-check",
      "command": [
        "{python}",
        "scripts/studies/axel-f/prepare-full-selected.py",
        "verify",
        "{stage:reference}/song",
        "{stage:candidate}/song",
        "{stage:original}/song",
        "{stage:full-input}/trial/adaptation.json",
        "{stage:diagnostics}",
        "--output",
        "{out}/verification.json"
      ],
      "inputs": [
        "scripts/studies/axel-f/prepare-full-selected.py",
        "scripts/studies/axel-f/prepare-full-rhythm.py",
        "scripts/studies/axel-f/prepare-rhythm-balance.py",
        "scripts/studies/axel-f/prepare-rhythm-trial.py",
        "scripts/studies/axel-f/prepare-kick-trial.py",
        "scripts/audio_comparison.py",
        "{stage:reference}/song/conversion.json",
        "{stage:reference}/song/native-song.frames.json",
        "{stage:reference}/song/native-song.writes.json",
        "{stage:reference}/song/native-song.wav",
        "{stage:reference}/song/native-song.wav.registers.tsv",
        "{stage:candidate}/song/conversion.json",
        "{stage:candidate}/song/native-song.frames.json",
        "{stage:candidate}/song/native-song.writes.json",
        "{stage:candidate}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav.registers.tsv",
        "{stage:original}/song/conversion.json",
        "{stage:original}/song/native-song.frames.json",
        "{stage:original}/song/native-song.writes.json",
        "{stage:original}/song/native-song.wav",
        "{stage:original}/song/native-song.wav.registers.tsv",
        "{stage:full-input}/trial/adaptation.json",
        "{stage:diagnostics}/reference-harmony.wav",
        "{stage:diagnostics}/reference-harmony.wav.registers.tsv",
        "{stage:diagnostics}/candidate-harmony.wav",
        "{stage:diagnostics}/candidate-harmony.wav.registers.tsv"
      ],
      "outputs": [
        "verification.json"
      ],
      "timeoutSeconds": 90,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "phrase",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "window",
        "{stage:original}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav",
        "{out}/comparison",
        "--start-seconds",
        "32.268864",
        "--end-seconds",
        "48.403296"
      ],
      "inputs": [
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py",
        "{stage:original}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav"
      ],
      "outputs": [
        "comparison.ab.wav",
        "comparison.comparison.json"
      ],
      "timeoutSeconds": 30
    },
    {
      "id": "ending",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "window",
        "{stage:original}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav",
        "{out}/comparison",
        "--start-seconds",
        "164",
        "--end-seconds",
        "179.634943"
      ],
      "inputs": [
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py",
        "{stage:original}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav"
      ],
      "outputs": [
        "comparison.ab.wav",
        "comparison.comparison.json"
      ],
      "timeoutSeconds": 30
    }
  ],
  "deliverables": {
    "previous": "{stage:original}/song/native-song.wav",
    "candidate": "{stage:candidate}/song/native-song.wav",
    "phrase": "{stage:phrase}/comparison.ab.wav",
    "ending": "{stage:ending}/comparison.ab.wav",
    "verification": "{stage:candidate}/song/verification.json",
    "vice": "{stage:vice}/vice/verification.json",
    "mechanism": "{stage:full-check}/verification.json",
    "adaptation": "{stage:full-input}/trial/adaptation.json",
    "candidate-sid": "{stage:candidate}/song/export/candidate.sid",
    "candidate-prg": "{stage:candidate}/song/export/candidate.prg"
  }
}
