{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "accepted",
      "command": [
        "{python}",
        "scripts/native-song.py",
        "build",
        "songs/studies/bach-toccata-full/hybrid.json",
        "--output",
        "{out}/song",
        "--excerpt-seconds",
        "13.5",
        "--excerpt-start",
        "30"
      ],
      "inputs": [
        "scripts/native-song.py",
        "scripts/arrange-sidwizard.py",
        "scripts/generate-native-instruments.py",
        "scripts/export-sidwizard.py",
        "scripts/audio_comparison.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/sid-wizard-exporter/build.json",
        ".tools/sid-wizard-exporter/exporter.prg",
        ".tools/sid-wizard-exporter/exporter.labels",
        ".local/bin/render-sid",
        "songs/studies/bach-toccata-full/score.json",
        "songs/studies/bach-toccata-full/hybrid.json",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "song/native-song.wav",
        "song/verification.json",
        "song/conversion.json",
        "song/export.json",
        "song/export/hybrid.sid",
        "song/export/hybrid.prg",
        "song/native-song.writes.json",
        "song/native-song.frames.json",
        "song/native-song.schedule.json",
        "song/native-song.render.json",
        "song/native-song.excerpt.wav"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "prior",
      "command": [
        "{python}",
        "scripts/native-song.py",
        "build",
        "songs/studies/bach-toccata-groove-blend/hybrid.json",
        "--output",
        "{out}/song",
        "--excerpt-seconds",
        "13.5",
        "--excerpt-start",
        "30"
      ],
      "inputs": [
        "scripts/native-song.py",
        "scripts/arrange-sidwizard.py",
        "scripts/generate-native-instruments.py",
        "scripts/export-sidwizard.py",
        "scripts/audio_comparison.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/sid-wizard-exporter/build.json",
        ".tools/sid-wizard-exporter/exporter.prg",
        ".tools/sid-wizard-exporter/exporter.labels",
        ".local/bin/render-sid",
        "songs/studies/bach-toccata-groove-blend/score.json",
        "songs/studies/bach-toccata-groove-blend/hybrid.json",
        "songs/studies/bach-toccata-groove-blend/preparation.json",
        "scripts/studies/bach/prepare-groove-blend.py",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "song/native-song.wav",
        "song/verification.json",
        "song/conversion.json",
        "song/export.json",
        "song/export/hybrid.sid",
        "song/export/hybrid.prg",
        "song/native-song.writes.json",
        "song/native-song.frames.json",
        "song/native-song.schedule.json",
        "song/native-song.render.json",
        "song/native-song.excerpt.wav"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate",
      "command": [
        "{python}",
        "scripts/native-song.py",
        "build",
        "songs/studies/bach-toccata-groove-release/hybrid.json",
        "--output",
        "{out}/song",
        "--excerpt-seconds",
        "13.5",
        "--excerpt-start",
        "30"
      ],
      "inputs": [
        "scripts/native-song.py",
        "scripts/arrange-sidwizard.py",
        "scripts/generate-native-instruments.py",
        "scripts/export-sidwizard.py",
        "scripts/audio_comparison.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/sid-wizard-exporter/build.json",
        ".tools/sid-wizard-exporter/exporter.prg",
        ".tools/sid-wizard-exporter/exporter.labels",
        ".local/bin/render-sid",
        "songs/studies/bach-toccata-groove-blend/score.json",
        "songs/studies/bach-toccata-groove-release/hybrid.json",
        "songs/studies/bach-toccata-groove-release/preparation.json",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "song/native-song.wav",
        "song/verification.json",
        "song/conversion.json",
        "song/export.json",
        "song/export/hybrid.sid",
        "song/export/hybrid.prg",
        "song/native-song.writes.json",
        "song/native-song.frames.json",
        "song/native-song.schedule.json",
        "song/native-song.render.json",
        "song/native-song.excerpt.wav"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "prior-comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "window",
        "{stage:prior}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav",
        "{out}/prior-then-revised",
        "--gap-seconds",
        "0.5",
        "--start-seconds",
        "30",
        "--end-seconds",
        "43.5"
      ],
      "inputs": [
        "{stage:prior}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "prior-then-revised.ab.wav",
        "prior-then-revised.comparison.json"
      ],
      "timeoutSeconds": 30
    },
    {
      "id": "comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "window",
        "{stage:accepted}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav",
        "{out}/accepted-then-candidate",
        "--gap-seconds",
        "0.5",
        "--start-seconds",
        "30",
        "--end-seconds",
        "43.5"
      ],
      "inputs": [
        "{stage:accepted}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "accepted-then-candidate.ab.wav",
        "accepted-then-candidate.comparison.json"
      ],
      "timeoutSeconds": 30
    },
    {
      "id": "intervention-check",
      "command": [
        "{python}",
        "scripts/native_frame_comparison.py",
        "{stage:prior}/song/native-song.frames.json",
        "{stage:candidate}/song/native-song.frames.json",
        "--allow-offset",
        "20",
        "--output",
        "{out}/comparison.json"
      ],
      "inputs": [
        "{stage:prior}/song/native-song.frames.json",
        "{stage:candidate}/song/native-song.frames.json",
        "scripts/native_frame_comparison.py"
      ],
      "outputs": [
        "comparison.json"
      ],
      "timeoutSeconds": 15
    },
    {
      "id": "candidate-vice",
      "command": [
        "{python}",
        "scripts/verify-native-vice.py",
        "{stage:candidate}/song/export/hybrid.prg",
        "{stage:candidate}/song/native-song.writes.json",
        "--export-report",
        "{stage:candidate}/song/export.json",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--calls",
        "1",
        "20",
        "611",
        "1500",
        "1555",
        "1570",
        "1600",
        "1800",
        "2000",
        "2090",
        "2150",
        "3000",
        "4370",
        "4400",
        "--output",
        "{out}/vice"
      ],
      "inputs": [
        "{stage:candidate}/song/export/hybrid.prg",
        "{stage:candidate}/song/native-song.writes.json",
        "{stage:candidate}/song/export.json",
        "scripts/verify-native-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "vice/verification.json"
      ],
      "timeoutSeconds": 90,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "deliverables": {
    "originalCandidate": "{stage:candidate}/song/native-song.wav",
    "acceptedThenCandidate": "{stage:comparison}/accepted-then-candidate.ab.wav",
    "acceptedVerification": "{stage:accepted}/song/verification.json",
    "candidateVerification": "{stage:candidate}/song/verification.json",
    "candidatePrg": "{stage:candidate}/song/export/hybrid.prg",
    "candidatePsid": "{stage:candidate}/song/export/hybrid.sid",
    "candidateVice": "{stage:candidate-vice}/vice/verification.json",
    "interventionVerification": "{stage:intervention-check}/comparison.json",
    "acceptedReference": "{stage:accepted}/song/native-song.wav",
    "acceptedPassage": "{stage:accepted}/song/native-song.excerpt.wav",
    "candidatePassage": "{stage:candidate}/song/native-song.excerpt.wav",
    "priorGroove": "{stage:prior}/song/native-song.wav",
    "priorPassage": "{stage:prior}/song/native-song.excerpt.wav",
    "priorVerification": "{stage:prior}/song/verification.json",
    "priorThenRevised": "{stage:prior-comparison}/prior-then-revised.ab.wav"
  }
}
