{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "prepare",
      "command": [
        "{python}",
        "scripts/prepare-score-audition.py",
        ".local/research/axel-f/winjammer-axelf.mid",
        "config/scores/axel-f-import.json",
        "--output",
        "{out}/score",
        "--arrangement",
        "songs/axel-f/full-reduction.json",
        "--candidate",
        "songs/axel-f/full-huelsbeck-pulse.json",
        "--reference",
        "songs/axel-f/full-native.json"
      ],
      "inputs": [
        ".local/research/axel-f/winjammer-axelf.mid",
        "config/scores/axel-f-import.json",
        "scripts/prepare-score-audition.py",
        "scripts/score_tools.py",
        "songs/axel-f/full-reduction.json",
        "songs/axel-f/full-native.json",
        ".tools/arrangement-deps/mido",
        "songs/axel-f/full-huelsbeck-pulse.json"
      ],
      "outputs": [
        "score/common-score.json",
        "score/score.json",
        "score/candidate.json",
        "score/reference.json",
        "score/adaptation.json",
        "score/source.mid",
        "score/import-recipe.json",
        "score/full-common-score.json"
      ],
      "timeoutSeconds": 30,
      "env": {
        "PYTHONPATH": "{root}/.tools/arrangement-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "trial",
      "command": [
        "{python}",
        "scripts/studies/axel-f/prepare-kick-trial.py",
        "prepare",
        "{stage:prepare}/score/full-common-score.json",
        "{stage:prepare}/score/score.json",
        "songs/axel-f/full-huelsbeck-pulse.json",
        "songs/studies/sidwizard-repertoire/repertoire.json",
        "songs/axel-f/kick-trial.json",
        "--output",
        "{out}/trial"
      ],
      "inputs": [
        "scripts/studies/axel-f/prepare-kick-trial.py",
        "scripts/audio_comparison.py",
        "{stage:prepare}/score/full-common-score.json",
        "{stage:prepare}/score/score.json",
        "songs/axel-f/full-huelsbeck-pulse.json",
        "songs/studies/sidwizard-repertoire/repertoire.json",
        "songs/axel-f/kick-trial.json"
      ],
      "outputs": [
        "trial/baseline-score.json",
        "trial/candidate-score.json",
        "trial/reference.json",
        "trial/candidate.json",
        "trial/adaptation.json"
      ],
      "timeoutSeconds": 30,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "reference",
      "command": [
        "{python}",
        "scripts/native-song.py",
        "build",
        "{stage:trial}/trial/reference.json",
        "--output",
        "{out}/song",
        "--excerpt-seconds",
        "16.134432",
        "--excerpt-start",
        "0"
      ],
      "inputs": [
        "scripts/native-song.py",
        "scripts/arrange-sidwizard.py",
        "scripts/generate-native-instruments.py",
        "scripts/export-sidwizard.py",
        "scripts/audio_comparison.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/sid-wizard-exporter/build.json",
        ".tools/sid-wizard-exporter/exporter.prg",
        ".tools/sid-wizard-exporter/exporter.labels",
        ".local/bin/render-sid",
        "scripts/sid_clock.py",
        "{stage:trial}/trial/reference.json",
        "{stage:trial}/trial/baseline-score.json"
      ],
      "outputs": [
        "song/native-song.wav",
        "song/verification.json",
        "song/conversion.json",
        "song/export.json",
        "song/export/reference.sid",
        "song/export/reference.prg",
        "song/native-song.writes.json",
        "song/native-song.frames.json",
        "song/native-song.schedule.json",
        "song/native-song.render.json",
        "song/native-song.audit.json",
        "song/native-song.native-events.json",
        "song/conversion/reference.swm",
        "song/native-song.excerpt.wav",
        "song/native-song.wav.registers.tsv"
      ],
      "timeoutSeconds": 360,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate",
      "command": [
        "{python}",
        "scripts/native-song.py",
        "build",
        "{stage:trial}/trial/candidate.json",
        "--output",
        "{out}/song",
        "--excerpt-seconds",
        "16.134432",
        "--excerpt-start",
        "0"
      ],
      "inputs": [
        "scripts/native-song.py",
        "scripts/arrange-sidwizard.py",
        "scripts/generate-native-instruments.py",
        "scripts/export-sidwizard.py",
        "scripts/audio_comparison.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/sid-wizard-exporter/build.json",
        ".tools/sid-wizard-exporter/exporter.prg",
        ".tools/sid-wizard-exporter/exporter.labels",
        ".local/bin/render-sid",
        "scripts/sid_clock.py",
        "{stage:trial}/trial/candidate.json",
        "{stage:trial}/trial/candidate-score.json"
      ],
      "outputs": [
        "song/native-song.wav",
        "song/verification.json",
        "song/conversion.json",
        "song/export.json",
        "song/export/candidate.sid",
        "song/export/candidate.prg",
        "song/native-song.writes.json",
        "song/native-song.frames.json",
        "song/native-song.schedule.json",
        "song/native-song.render.json",
        "song/native-song.audit.json",
        "song/native-song.native-events.json",
        "song/conversion/candidate.swm",
        "song/native-song.excerpt.wav",
        "song/native-song.wav.registers.tsv"
      ],
      "timeoutSeconds": 360,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "vice",
      "command": [
        "{python}",
        "scripts/verify-native-vice.py",
        "{stage:candidate}/song/export/candidate.prg",
        "{stage:candidate}/song/native-song.writes.json",
        "--export-report",
        "{stage:candidate}/song/export.json",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--calls",
        "1",
        "3",
        "6",
        "150",
        "400",
        "810",
        "930",
        "980",
        "--output",
        "{out}/vice"
      ],
      "inputs": [
        "{stage:candidate}/song/export/candidate.prg",
        "{stage:candidate}/song/native-song.writes.json",
        "{stage:candidate}/song/export.json",
        "scripts/verify-native-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "vice/verification.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "kick-only",
      "command": [
        "{python}",
        "-c",
        "import json,pathlib,subprocess,sys\nseconds=json.loads(pathlib.Path(sys.argv[1]).read_text())[\"pcm\"][\"durationSeconds\"]\nsubprocess.run([sys.argv[2],sys.argv[3],sys.argv[4],str(seconds),\"--voices\",sys.argv[5],\"--clock\",\"pal\"],check=True,timeout=30)\n",
        "{stage:candidate}/song/verification.json",
        ".local/bin/render-sid",
        "{stage:candidate}/song/export/candidate.sid",
        "{out}/kick-only.wav",
        "2"
      ],
      "inputs": [
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a",
        "{stage:candidate}/song/export/candidate.sid",
        "{stage:candidate}/song/verification.json"
      ],
      "outputs": [
        "kick-only.wav",
        "kick-only.wav.registers.tsv"
      ],
      "timeoutSeconds": 30
    },
    {
      "id": "kick-muted",
      "command": [
        "{python}",
        "-c",
        "import json,pathlib,subprocess,sys\nseconds=json.loads(pathlib.Path(sys.argv[1]).read_text())[\"pcm\"][\"durationSeconds\"]\nsubprocess.run([sys.argv[2],sys.argv[3],sys.argv[4],str(seconds),\"--voices\",sys.argv[5],\"--clock\",\"pal\"],check=True,timeout=30)\n",
        "{stage:candidate}/song/verification.json",
        ".local/bin/render-sid",
        "{stage:candidate}/song/export/candidate.sid",
        "{out}/kick-muted.wav",
        "1,3"
      ],
      "inputs": [
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a",
        "{stage:candidate}/song/export/candidate.sid",
        "{stage:candidate}/song/verification.json"
      ],
      "outputs": [
        "kick-muted.wav",
        "kick-muted.wav.registers.tsv"
      ],
      "timeoutSeconds": 30
    },
    {
      "id": "mechanism",
      "command": [
        "{python}",
        "scripts/studies/axel-f/prepare-kick-trial.py",
        "verify",
        "{stage:reference}/song",
        "{stage:candidate}/song",
        "--output",
        "{out}/mechanism.json",
        "--kick-only",
        "{stage:kick-only}/kick-only.wav",
        "--kick-muted",
        "{stage:kick-muted}/kick-muted.wav"
      ],
      "inputs": [
        "scripts/studies/axel-f/prepare-kick-trial.py",
        "scripts/audio_comparison.py",
        "{stage:reference}/song/native-song.frames.json",
        "{stage:candidate}/song/native-song.frames.json",
        "{stage:candidate}/song/conversion.json",
        "{stage:reference}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav",
        "{stage:kick-only}/kick-only.wav",
        "{stage:kick-muted}/kick-muted.wav",
        "{stage:reference}/song/native-song.writes.json",
        "{stage:candidate}/song/native-song.writes.json",
        "{stage:kick-muted}/kick-muted.wav.registers.tsv",
        "{stage:candidate}/song/native-song.wav.registers.tsv"
      ],
      "outputs": [
        "mechanism.json"
      ],
      "timeoutSeconds": 30,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "window",
        "{stage:kick-muted}/kick-muted.wav",
        "{stage:candidate}/song/native-song.wav",
        "{out}/without-then-with-kick",
        "--start-seconds",
        "0",
        "--end-seconds",
        "16.134432"
      ],
      "inputs": [
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py",
        "{stage:candidate}/song/native-song.wav",
        "{stage:kick-muted}/kick-muted.wav"
      ],
      "outputs": [
        "without-then-with-kick.ab.wav",
        "without-then-with-kick.comparison.json"
      ],
      "timeoutSeconds": 30
    }
  ],
  "deliverables": {
    "reference": "{stage:kick-muted}/kick-muted.wav",
    "candidate": "{stage:candidate}/song/native-song.wav",
    "comparison": "{stage:comparison}/without-then-with-kick.ab.wav",
    "kick-only": "{stage:kick-only}/kick-only.wav",
    "verification": "{stage:candidate}/song/verification.json",
    "vice": "{stage:vice}/vice/verification.json",
    "mechanism": "{stage:mechanism}/mechanism.json",
    "adaptation": "{stage:trial}/trial/adaptation.json",
    "candidate-sid": "{stage:candidate}/song/export/candidate.sid",
    "candidate-prg": "{stage:candidate}/song/export/candidate.prg",
    "candidate-native": "{stage:candidate}/song/conversion/candidate.swm",
    "native-without-kick": "{stage:reference}/song/native-song.wav"
  }
}
