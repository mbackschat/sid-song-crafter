{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "prepare",
      "command": [
        "{python}",
        "scripts/prepare-score-audition.py",
        ".local/research/axel-f/winjammer-axelf.mid",
        "config/scores/axel-f-import.json",
        "--output",
        "{out}/score",
        "--arrangement",
        "songs/axel-f/reduction.json",
        "--candidate",
        "songs/axel-f/huelsbeck-pulse.json",
        "--reference",
        "songs/axel-f/smoother.json"
      ],
      "inputs": [
        ".local/research/axel-f/winjammer-axelf.mid",
        "config/scores/axel-f-import.json",
        "scripts/prepare-score-audition.py",
        "scripts/score_tools.py",
        "songs/axel-f/reduction.json",
        ".tools/arrangement-deps/mido",
        "songs/axel-f/smoother.json",
        "songs/axel-f/huelsbeck-pulse.json"
      ],
      "outputs": [
        "score/common-score.json",
        "score/score.json",
        "score/candidate.json",
        "score/reference.json",
        "score/adaptation.json",
        "score/source.mid",
        "score/import-recipe.json",
        "score/full-common-score.json"
      ],
      "timeoutSeconds": 30,
      "env": {
        "PYTHONPATH": "{root}/.tools/arrangement-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "reference",
      "command": [
        "{python}",
        "scripts/native-song.py",
        "build",
        "{stage:prepare}/score/reference.json",
        "--output",
        "{out}/song",
        "--excerpt-seconds",
        "20",
        "--excerpt-start",
        "0"
      ],
      "inputs": [
        "scripts/native-song.py",
        "scripts/arrange-sidwizard.py",
        "scripts/generate-native-instruments.py",
        "scripts/export-sidwizard.py",
        "scripts/audio_comparison.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/sid-wizard-exporter/build.json",
        ".tools/sid-wizard-exporter/exporter.prg",
        ".tools/sid-wizard-exporter/exporter.labels",
        ".local/bin/render-sid",
        "scripts/sid_clock.py",
        "{stage:prepare}/score/reference.json",
        "{stage:prepare}/score/score.json"
      ],
      "outputs": [
        "song/native-song.wav",
        "song/verification.json",
        "song/conversion.json",
        "song/export.json",
        "song/export/reference.sid",
        "song/export/reference.prg",
        "song/native-song.writes.json",
        "song/native-song.frames.json",
        "song/native-song.schedule.json",
        "song/native-song.render.json",
        "song/native-song.audit.json",
        "song/native-song.native-events.json",
        "song/conversion/reference.swm",
        "song/native-song.excerpt.wav"
      ],
      "timeoutSeconds": 240,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate",
      "command": [
        "{python}",
        "scripts/native-song.py",
        "build",
        "{stage:prepare}/score/candidate.json",
        "--output",
        "{out}/song",
        "--excerpt-seconds",
        "20",
        "--excerpt-start",
        "0"
      ],
      "inputs": [
        "scripts/native-song.py",
        "scripts/arrange-sidwizard.py",
        "scripts/generate-native-instruments.py",
        "scripts/export-sidwizard.py",
        "scripts/audio_comparison.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/sid-wizard-exporter/build.json",
        ".tools/sid-wizard-exporter/exporter.prg",
        ".tools/sid-wizard-exporter/exporter.labels",
        ".local/bin/render-sid",
        "scripts/sid_clock.py",
        "{stage:prepare}/score/candidate.json",
        "{stage:prepare}/score/score.json"
      ],
      "outputs": [
        "song/native-song.wav",
        "song/verification.json",
        "song/conversion.json",
        "song/export.json",
        "song/export/candidate.sid",
        "song/export/candidate.prg",
        "song/native-song.writes.json",
        "song/native-song.frames.json",
        "song/native-song.schedule.json",
        "song/native-song.render.json",
        "song/native-song.audit.json",
        "song/native-song.native-events.json",
        "song/conversion/candidate.swm",
        "song/native-song.excerpt.wav"
      ],
      "timeoutSeconds": 240,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "isolation",
      "command": [
        "{python}",
        "scripts/native_frame_comparison.py",
        "{stage:reference}/song/native-song.frames.json",
        "{stage:candidate}/song/native-song.frames.json",
        "--allow-offset",
        "2",
        "--allow-offset",
        "3",
        "--output",
        "{out}/pulse-only.json"
      ],
      "inputs": [
        "scripts/native_frame_comparison.py",
        "{stage:reference}/song/native-song.frames.json",
        "{stage:candidate}/song/native-song.frames.json"
      ],
      "outputs": [
        "pulse-only.json"
      ],
      "timeoutSeconds": 30
    },
    {
      "id": "pulse-trajectory",
      "command": [
        "{python}",
        "-c",
        "import hashlib,json,pathlib,sys\n\ndef require(condition,message):\n    if not condition: raise ValueError(message)\n\nframe_path,event_path,manifest_path,output_path=map(pathlib.Path,sys.argv[1:])\nframes=json.loads(frame_path.read_text())\nevents=json.loads(event_path.read_text())\nmanifest=json.loads(manifest_path.read_text())\nwidths=[row[2]+((row[3]&15)<<8) for row in frames]\nstarts=[event['tick'] for event in events['starts'] if event['voice']==0]\nrequire(starts and all(widths[tick+1]==0x200 for tick in starts),'Every selected lead onset must reset its pulse width to $200')\nreset=starts[-1]+1\nstop=manifest['stopTick']\nrequire(reset+127<stop<len(frames),'Final lead release must expose a complete bounded pulse loop before native volume clear')\nexpected=dict(((0,0x200),(29,0x5f7),(30,0x5f7),(45,0x3ea),(46,0x3ea),(61,0x5f7),(62,0x5f7),(63,0x5f7),(78,0x3ea),(94,0x5f7),(111,0x3ea),(127,0x5f7)))\nrequire(all(widths[reset+offset]==value for offset,value in expected.items()),'Native pulse extrema or transition-call timing differ from the declared trajectory')\nrequire(all(widths[reset+offset]==0x200+35*offset for offset in range(30)),'Native pulse onset must make 29 exact +35 steps')\nrequire(all(0x3ea<=value<=0x5f7 for value in widths[reset+31:stop]),'Native pulse loop must remain within $3ea..$5f7')\nrequire(all(after-before in (-35,0,35) for before,after in zip(widths[reset:stop-1],widths[reset+1:stop])),'Native pulse loop must use only signed 35-unit steps and transition holds')\nrate=manifest['ticksPerSecond']\ngate_clear=next(tick for tick in range(reset,stop) if not frames[tick][4]&1)\nreport=dict(schemaVersion=1,frameSha256=hashlib.sha256(frame_path.read_bytes()).hexdigest(),eventSha256=hashlib.sha256(event_path.read_bytes()).hexdigest(),manifestSha256=hashlib.sha256(manifest_path.read_bytes()).hexdigest(),leadOnsets=len(starts),allOnsetsResetTo=0x200,finalLeadResetFrame=reset,finalLeadGateClearFrame=gate_clear,firstPeakFrame=reset+29,firstPeakElapsedSeconds=29/rate,loopMinimum=0x3ea,loopMaximum=0x5f7,steadyCycleFrames=33,steadyCycleSeconds=33/rate,steadyDescentFrames=17,steadyRiseFrames=16,transitionHoldsIncluded=True,checkedBoundaryFrames=[dict(frame=reset+offset,pulseWidth=widths[reset+offset]) for offset in expected],scope='Independent native adaptation: reset and bounded pulse trajectory in executed post-call registers. Final-note loop evidence includes release, and does not establish audible sustain or source-driver equivalence.')\nwith output_path.open('x') as output: output.write(json.dumps(report,indent=2)+chr(10))\n",
        "{stage:candidate}/song/native-song.frames.json",
        "{stage:candidate}/song/native-song.native-events.json",
        "{stage:candidate}/song/conversion.json",
        "{out}/pulse-trajectory.json"
      ],
      "inputs": [
        "{stage:candidate}/song/native-song.frames.json",
        "{stage:candidate}/song/native-song.native-events.json",
        "{stage:candidate}/song/conversion.json"
      ],
      "outputs": [
        "pulse-trajectory.json"
      ],
      "timeoutSeconds": 30
    },
    {
      "id": "vice",
      "command": [
        "{python}",
        "scripts/verify-native-vice.py",
        "{stage:candidate}/song/export/candidate.prg",
        "{stage:candidate}/song/native-song.writes.json",
        "--export-report",
        "{stage:candidate}/song/export.json",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--calls",
        "1",
        "3",
        "300",
        "800",
        "1500",
        "1750",
        "1790",
        "--output",
        "{out}/vice"
      ],
      "inputs": [
        "{stage:candidate}/song/export/candidate.prg",
        "{stage:candidate}/song/native-song.writes.json",
        "{stage:candidate}/song/export.json",
        "scripts/verify-native-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "vice/verification.json"
      ],
      "timeoutSeconds": 90,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "window",
        "{stage:reference}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav",
        "{out}/previous-then-narrow-pulse",
        "--start-seconds",
        "0",
        "--end-seconds",
        "16.1"
      ],
      "inputs": [
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py",
        "{stage:reference}/song/native-song.wav",
        "{stage:candidate}/song/native-song.wav"
      ],
      "outputs": [
        "previous-then-narrow-pulse.ab.wav",
        "previous-then-narrow-pulse.comparison.json"
      ],
      "timeoutSeconds": 30
    }
  ],
  "deliverables": {
    "reference": "{stage:reference}/song/native-song.wav",
    "candidate": "{stage:candidate}/song/native-song.wav",
    "comparison": "{stage:comparison}/previous-then-narrow-pulse.ab.wav",
    "reference-opening": "{stage:reference}/song/native-song.excerpt.wav",
    "candidate-opening": "{stage:candidate}/song/native-song.excerpt.wav",
    "verification": "{stage:candidate}/song/verification.json",
    "vice": "{stage:vice}/vice/verification.json",
    "isolation": "{stage:isolation}/pulse-only.json",
    "pulse-trajectory": "{stage:pulse-trajectory}/pulse-trajectory.json"
  }
}
