        "import importlib.util,json,pathlib,sys,math\nspec=importlib.util.spec_from_file_location(\"balance\",\"scripts/studies/axel-f/prepare-rhythm-balance.py\");m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\na,b,diag,tones,out=map(pathlib.Path,sys.argv[1:]);read=lambda p:json.loads(p.read_text())\nsolo=[m.read_pcm16(diag/(n+\"-drums.wav\")) for n in (\"motion\",\"balanced\")];muted=[m.read_pcm16(tones/(n+\"-tones.wav\")) for n in (\"motion\",\"balanced\")]\nfor folder,name in zip((a,b),(\"motion\",\"balanced\")):\n for d,suffix in ((diag,\"-drums.wav\"),(tones,\"-tones.wav\")):\n  m.require((d/(name+suffix+\".registers.tsv\")).read_bytes()==(folder/\"native-song.wav.registers.tsv\").read_bytes(),\"Diagnostic snapshots differ\")\ntiming,identical=m.verify_isolation(read(a/\"native-song.writes.json\"),read(b/\"native-song.writes.json\"),muted[0].samples,muted[1].samples)\nmanifest=read(b/\"conversion.json\");notes=manifest[\"voices\"][1][\"notes\"];rows=[];energy=[0.0,0.0];count=0\nfor i,n in enumerate(notes):\n end=notes[i+1][\"startTick\"] if i+1<len(notes) else manifest[\"scoreTicks\"]\n first,last=[round(t/manifest[\"ticksPerSecond\"]*solo[0].sample_rate) for t in (n[\"startTick\"]+1,end)]\n metrics=[m.measure_pcm(m.portion(x,first,last)) for x in solo]\n m.require(all(x[\"acRms\"]>1 and x[\"clippedSamples\"]==0 for x in metrics),\"Missing or clipped percussion body\")\n rows.append(dict(startTick=n[\"startTick\"],role=n[\"instrumentId\"],previousAcRms=metrics[0][\"acRms\"],candidateAcRms=metrics[1][\"acRms\"]))\n if n[\"instrumentId\"]==\"snare-8b3b\":\n  count+=1\n  for j in range(2):energy[j]+=metrics[j][\"acRms\"]**2*(last-first)\nm.require(count==16 and len(rows)==82,\"Percussion roles changed\")\nchange=m.measured_reduction(math.sqrt(energy[0]),math.sqrt(energy[1]),1,3)\nout.write_text(json.dumps(dict(schemaVersion=1,unchangedTonalPcm=identical,maximumInstructionStartDifferenceCycles=timing,snareWindowEnergyChangeDb=change,snareWindows=count,percussionWindows=rows),indent=2)+\"\\n\")\n",
        "{stage:motion}/song",
        "{stage:balanced}/song",
        "{stage:diagnostics}",
        "{stage:tones}",
        "{out}/balance.json"
      ],
      "inputs": [
