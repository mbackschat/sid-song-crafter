        "scripts/studies/axel-f/prepare-rhythm-character.py",
        "scripts/studies/axel-f/prepare-rhythm-trial.py",
        "scripts/studies/axel-f/prepare-timbre.py",
        "{stage:balanced}/song/conversion.json",
        "{stage:balanced}/song/native-song.wav.registers.tsv",
        "{stage:balanced}/song/native-song.writes.json",
        "{stage:diagnostics}/balanced-drums.wav",
