{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "compiler-guards",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "-v",
        "ghostbusters_compiler_test"
      ],
      "inputs": [
        "tests/ghostbusters_compiler_test.py",
        "scripts/studies/ghostbusters/compiler.py",
        "scripts/studies/ghostbusters/player.py",
        "scripts/studies/ghostbusters/score.py",
        "scripts/studies/ghostbusters/programs.py",
        "songs/players/ghostbusters.asm",
        "scripts/sid_assembler.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65"
      ],
      "outputs": [],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "music-component-export",
      "command": [
        "{python}",
        "scripts/studies/ghostbusters/compiler.py",
        "evidence/ghostbusters-player/composition.json",
        "--output",
        "{out}/candidate"
      ],
      "inputs": [
        "evidence/ghostbusters-player/composition.json",
        "scripts/studies/ghostbusters/compiler.py",
        "scripts/studies/ghostbusters/player.py",
        "scripts/studies/ghostbusters/score.py",
        "scripts/studies/ghostbusters/programs.py",
        "songs/players/ghostbusters.asm",
        "scripts/sid_assembler.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65"
      ],
      "outputs": [
        "candidate/reconstructed.sid",
        "candidate/reconstructed.prg",
        "candidate/verification.json",
        "candidate/audit.json",
        "candidate/writes.json",
        "candidate/state-checkpoints.json",
        "candidate/player.asm",
        "candidate/player.listing",
        "candidate/build.json"
      ],
      "timeoutSeconds": 300,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "ntsc-music-vice",
      "command": [
        "{python}",
        "scripts/trace-sid-vice.py",
        "{stage:music-component-export}/candidate/reconstructed.sid",
        "--oracle",
        "{stage:music-component-export}/candidate/writes.json",
        "--first-call",
        "0",
        "--last-call",
        "13960",
        "--clock",
        "ntsc",
        "--profile",
        "strict",
        "--subtune",
        "1",
        "--vice",
        ".tools/vice-headless-3.9/build/src/x64sc",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--timeout",
        "600",
        "--output",
        "{out}/vice"
      ],
      "inputs": [
        "{stage:music-component-export}/candidate/reconstructed.sid",
        "{stage:music-component-export}/candidate/writes.json",
        "scripts/trace-sid-vice.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        "scripts/verify_player.py",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib"
      ],
      "outputs": [
        "vice/study.json",
        "vice/trace.json",
        "vice/monitor.log",
        "vice/process.log",
        "vice/command.json",
        "vice/commands.mon",
        "vice/payload.prg",
        "vice/harness.prg"
      ],
      "timeoutSeconds": 630,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "deliverables": {
    "musicComponentSid": "{stage:music-component-export}/candidate/reconstructed.sid",
    "musicComponentPrg": "{stage:music-component-export}/candidate/reconstructed.prg",
    "cpuMusicProof": "{stage:music-component-export}/candidate/verification.json",
    "compiledStateCheckpoints": "{stage:music-component-export}/candidate/state-checkpoints.json",
    "viceMusicPlayProof": "{stage:ntsc-music-vice}/vice/study.json"
  }
}
