{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "reference-pin",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "asset",
        ".local/monty-source.sid",
        "--sha256",
        "528a7330817e4a0a0f75a505e9fe2444e07c5072ce5383ceaa89f183f0eee3ab",
        "--output",
        "{out}/reference.json"
      ],
      "inputs": [
        ".local/monty-source.sid",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "reference.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "build",
      "command": [
        "{python}",
        "scripts/compose-monty.py",
        "songs/monty-title-source.json",
        "--output",
        "{out}/candidate"
      ],
      "inputs": [
        "songs/monty-title-source.json",
        "scripts/compose-monty.py",
        "scripts/monty_title_player.py",
        "scripts/monty_title_score.py",
        "scripts/monty_title_programs.py",
        "scripts/sid_assembler.py",
        "songs/players/monty.asm",
        "songs/players/monty-effects.asm",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65"
      ],
      "outputs": [
        "candidate/reconstructed.sid",
        "candidate/build.json",
        "candidate/audit.json",
        "candidate/writes.json",
        "candidate/state-checkpoints.json",
        "candidate/player.asm",
        "candidate/player.listing"
      ],
      "timeoutSeconds": 600,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "source-writes",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "writes",
        "evidence/monty-form/full40000/audit.writes.json.gz",
        "{stage:build}/candidate/writes.json",
        "--source-sha256",
        "7a9021a04e20a4e9f482de5af4606b8cb7c19b06612395293a9868b875f24df5",
        "--calls",
        "40000",
        "--output",
        "{out}/source-comparison.json"
      ],
      "inputs": [
        "evidence/monty-form/full40000/audit.writes.json.gz",
        "{stage:build}/candidate/writes.json",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "source-comparison.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "vice",
      "command": [
        "{python}",
        "scripts/trace-sid-vice.py",
        "{stage:build}/candidate/reconstructed.sid",
        "--oracle",
        "{stage:build}/candidate/writes.json",
        "--first-call",
        "17520",
        "--last-call",
        "17800",
        "--timeout",
        "180",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--output",
        "{out}/vice"
      ],
      "inputs": [
        "{stage:build}/candidate/reconstructed.sid",
        "{stage:build}/candidate/writes.json",
        "scripts/trace-sid-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib"
      ],
      "outputs": [
        "vice/study.json",
        "vice/trace.json",
        "vice/monitor.log",
        "vice/command.json",
        "vice/commands.mon"
      ],
      "timeoutSeconds": 210,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "reference-render",
      "command": [
        "{root}/.local/bin/render-sid",
        ".local/monty-source.sid",
        "{out}/render.wav",
        "355"
      ],
      "inputs": [
        ".local/monty-source.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:build}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "355"
      ],
      "inputs": [
        "{stage:build}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "signal-check",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "audio",
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "--seconds",
        "355",
        "--output",
        "{out}/audio.json"
      ],
      "inputs": [
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "audio.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "opening",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "window",
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "{out}/opening-reference-then-ours",
        "--start-seconds",
        "0",
        "--end-seconds",
        "24",
        "--gap-seconds",
        "0.5"
      ],
      "inputs": [
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "opening-reference-then-ours.ab.wav",
        "opening-reference-then-ours.comparison.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "ending",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "window",
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "{out}/ending-reference-then-ours",
        "--start-seconds",
        "340",
        "--end-seconds",
        "355",
        "--gap-seconds",
        "0.5"
      ],
      "inputs": [
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "ending-reference-then-ours.ab.wav",
        "ending-reference-then-ours.comparison.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "deliverables": {
    "fullReference": "{stage:reference-render}/render.wav",
    "fullCandidate": "{stage:candidate-render}/render.wav",
    "opening": "{stage:opening}/opening-reference-then-ours.ab.wav",
    "ending": "{stage:ending}/ending-reference-then-ours.ab.wav"
  }
}
