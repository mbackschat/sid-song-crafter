      "id": "diagnostics",
      "command": [
        "{python}",
        "-c",
        "import json,pathlib,subprocess,sys\nseconds=json.loads(pathlib.Path(sys.argv[1]).read_text())[\"pcm\"][\"durationSeconds\"]\nfor name,sid in zip((\"baseline\",\"contour\"),sys.argv[3:5]):\n subprocess.run([sys.argv[2],sid,str(pathlib.Path(sys.argv[5])/(name+\"-drums.wav\")),str(seconds),\"--voices\",\"2\",\"--clock\",\"pal\"],check=True,timeout=30)\n",
        "{stage:baseline}/song/verification.json",
        ".local/bin/render-sid",
        "{stage:baseline}/song/export/baseline.sid",
        "{stage:contour}/song/export/contour.sid",
