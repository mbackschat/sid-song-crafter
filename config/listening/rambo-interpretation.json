{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "prepare",
      "command": [
        "{python}",
        "scripts/studies/rambo/prepare-interpretation.py",
        "prepare",
        "songs/studies/rambo-interpretation/palette.json",
        "--output",
        "{out}/prepared"
      ],
      "inputs": [
        "scripts/studies/rambo/prepare-interpretation.py",
        "songs/studies/rambo-interpretation/palette.json",
        "songs/rambo-loader.json",
        "scripts/rambo_player.py",
        "scripts/rambo_score.py",
        "scripts/rambo_programs.py",
        "scripts/verify_player.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "prepared/candidate.json",
        "prepared/score-invariants.json",
        "prepared/score-events.json.gz"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "faithful-pin",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "asset",
        "samples/rambo-loader/rambo-loader.sid",
        "--sha256",
        "9a6901e656f4de1888f9acc71c80abaf3608b9758b559b306b0b8b6eaa64aecd",
        "--output",
        "{out}/faithful.json"
      ],
      "inputs": [
        "samples/rambo-loader/rambo-loader.sid",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "faithful.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "original-pin",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "asset",
        ".local/rambo-source.sid",
        "--sha256",
        "88a2b538ee3d3d1d8b0b754bef77a63d9750812694786977ae8c539f6ecd000e",
        "--output",
        "{out}/original.json"
      ],
      "inputs": [
        ".local/rambo-source.sid",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "original.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "original-render",
      "command": [
        "{root}/.local/bin/render-sid",
        ".local/rambo-source.sid",
        "{out}/render.wav",
        "225",
        "--clock",
        "pal",
        "--subtune",
        "1"
      ],
      "inputs": [
        ".local/rambo-source.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-build",
      "command": [
        "{python}",
        "scripts/compose-rambo.py",
        "{stage:prepare}/prepared/candidate.json",
        "--output",
        "{out}/candidate"
      ],
      "inputs": [
        "{stage:prepare}/prepared/candidate.json",
        "scripts/compose-rambo.py",
        "scripts/rambo_player.py",
        "scripts/rambo_score.py",
        "scripts/rambo_programs.py",
        "scripts/verify_player.py",
        "scripts/sid_assembler.py",
        "songs/players/rambo.asm",
        "songs/players/rambo-sound.asm",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        ".tools/test-deps/py65"
      ],
      "outputs": [
        "candidate/reconstructed.sid",
        "candidate/build.json",
        "candidate/audit.json",
        "candidate/writes.json",
        "candidate/state-checkpoints.json",
        "candidate/player.asm",
        "candidate/player.listing"
      ],
      "timeoutSeconds": 600,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-vice",
      "command": [
        "{python}",
        "scripts/trace-sid-vice.py",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "--oracle",
        "{stage:candidate-build}/candidate/writes.json",
        "--first-call",
        "0",
        "--last-call",
        "10999",
        "--timeout",
        "300",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--output",
        "{out}/vice",
        "--profile",
        "pal-banked",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{stage:candidate-build}/candidate/writes.json",
        "scripts/trace-sid-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        "scripts/sid_clock.py",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib"
      ],
      "outputs": [
        "vice/study.json",
        "vice/trace.json",
        "vice/monitor.log",
        "vice/command.json",
        "vice/commands.mon"
      ],
      "timeoutSeconds": 330,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "faithful-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "samples/rambo-loader/rambo-loader.sid",
        "{out}/render.wav",
        "225",
        "--clock",
        "pal",
        "--subtune",
        "1"
      ],
      "inputs": [
        "samples/rambo-loader/rambo-loader.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "225",
        "--clock",
        "pal",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "health",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "audio",
        "{stage:faithful-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "--seconds",
        "225",
        "--tail-seconds",
        "1",
        "--max-tail-ac-rms",
        "1",
        "--output",
        "{out}/audio.json"
      ],
      "inputs": [
        "{stage:faithful-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "audio.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "without-lead",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "225",
        "--clock",
        "pal",
        "--subtune",
        "1",
        "--voices",
        "2,3"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "without-bass",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "225",
        "--clock",
        "pal",
        "--subtune",
        "1",
        "--voices",
        "1,3"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "without-support",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "225",
        "--clock",
        "pal",
        "--subtune",
        "1",
        "--voices",
        "1,2"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "windows",
      "command": [
        "{python}",
        "scripts/studies/rambo/prepare-interpretation.py",
        "windows",
        "--faithful",
        "{stage:faithful-render}/render.wav",
        "--candidate",
        "{stage:candidate-render}/render.wav",
        "--original",
        "{stage:original-render}/render.wav",
        "--output",
        "{out}/windows"
      ],
      "inputs": [
        "scripts/studies/rambo/prepare-interpretation.py",
        "{stage:faithful-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "{stage:original-render}/render.wav",
        "scripts/rambo_player.py",
        "scripts/rambo_score.py",
        "scripts/rambo_programs.py",
        "scripts/verify_player.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "windows/faithful-phrase.wav",
        "windows/interpretation-phrase.wav",
        "windows/original-source-phrase.wav",
        "windows/faithful-ending.wav",
        "windows/interpretation-ending.wav",
        "windows/original-source-ending.wav",
        "windows/windows.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "phrase-comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "prepare",
        "{stage:windows}/windows/faithful-phrase.wav",
        "{stage:windows}/windows/interpretation-phrase.wav",
        "{out}/faithful-then-interpretation-phrase",
        "--individual-copies",
        "--gap-seconds",
        "0.5"
      ],
      "inputs": [
        "{stage:windows}/windows/faithful-phrase.wav",
        "{stage:windows}/windows/interpretation-phrase.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "faithful-then-interpretation-phrase.ab.wav",
        "faithful-then-interpretation-phrase.comparison.json",
        "faithful-then-interpretation-phrase.a.matched.wav",
        "faithful-then-interpretation-phrase.b.matched.wav"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "ending-comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "prepare",
        "{stage:windows}/windows/faithful-ending.wav",
        "{stage:windows}/windows/interpretation-ending.wav",
        "{out}/faithful-then-interpretation-ending",
        "--individual-copies",
        "--gap-seconds",
        "0.5"
      ],
      "inputs": [
        "{stage:windows}/windows/faithful-ending.wav",
        "{stage:windows}/windows/interpretation-ending.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "faithful-then-interpretation-ending.ab.wav",
        "faithful-then-interpretation-ending.comparison.json",
        "faithful-then-interpretation-ending.a.matched.wav",
        "faithful-then-interpretation-ending.b.matched.wav"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "contribution",
      "command": [
        "{python}",
        "scripts/studies/rambo/prepare-interpretation.py",
        "signal",
        "songs/studies/rambo-interpretation/palette.json",
        "--faithful",
        "{stage:faithful-render}/render.wav",
        "--candidate",
        "{stage:candidate-render}/render.wav",
        "--comparison",
        "{stage:phrase-comparison}/faithful-then-interpretation-phrase.comparison.json",
        "--invariants",
        "{stage:prepare}/prepared/score-invariants.json",
        "--diagnostics",
        "{stage:without-lead}/render.wav",
        "{stage:without-bass}/render.wav",
        "{stage:without-support}/render.wav",
        "--output",
        "{out}/contribution.json"
      ],
      "inputs": [
        "scripts/studies/rambo/prepare-interpretation.py",
        "songs/studies/rambo-interpretation/palette.json",
        "{stage:faithful-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "{stage:phrase-comparison}/faithful-then-interpretation-phrase.comparison.json",
        "{stage:prepare}/prepared/score-invariants.json",
        "{stage:without-lead}/render.wav",
        "{stage:without-bass}/render.wav",
        "{stage:without-support}/render.wav",
        "scripts/rambo_player.py",
        "scripts/rambo_score.py",
        "scripts/rambo_programs.py",
        "scripts/verify_player.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "contribution.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "deliverables": {
    "fullFaithful": "{stage:faithful-render}/render.wav",
    "fullCandidate": "{stage:candidate-render}/render.wav",
    "phraseComparison": "{stage:phrase-comparison}/faithful-then-interpretation-phrase.ab.wav",
    "endingComparison": "{stage:ending-comparison}/faithful-then-interpretation-ending.ab.wav",
    "originalSourcePhrase": "{stage:windows}/windows/original-source-phrase.wav",
    "originalSourceEnding": "{stage:windows}/windows/original-source-ending.wav",
    "matchedFaithfulPhrase": "{stage:phrase-comparison}/faithful-then-interpretation-phrase.a.matched.wav",
    "matchedInterpretationPhrase": "{stage:phrase-comparison}/faithful-then-interpretation-phrase.b.matched.wav",
    "scoreInvariants": "{stage:prepare}/prepared/score-invariants.json",
    "candidateBuild": "{stage:candidate-build}/candidate/build.json",
    "candidateVice": "{stage:candidate-vice}/vice/study.json",
    "audioHealth": "{stage:health}/audio.json",
    "signalContribution": "{stage:contribution}/contribution.json",
    "candidateSid": "{stage:candidate-build}/candidate/reconstructed.sid",
    "fullOriginalSource": "{stage:original-render}/render.wav"
  }
}
