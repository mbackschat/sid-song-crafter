{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "previous",
      "command": [
        "{python}",
        "scripts/native-song.py",
        "build",
        "songs/studies/bach-toccata-opening/hybrid.json",
        "--output",
        "{out}/song",
        "--excerpt-seconds",
        "24"
      ],
      "inputs": [
        "scripts/native-song.py",
        "scripts/arrange-sidwizard.py",
        "scripts/generate-native-instruments.py",
        "scripts/export-sidwizard.py",
        "scripts/audio_comparison.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/sid-wizard-exporter/build.json",
        ".tools/sid-wizard-exporter/exporter.prg",
        ".tools/sid-wizard-exporter/exporter.labels",
        ".local/bin/render-sid",
        "songs/studies/bach-toccata-opening/score.json",
        "songs/studies/bach-toccata-opening/hybrid.json"
      ],
      "outputs": [
        "song/native-song.wav",
        "song/verification.json",
        "song/conversion.json",
        "song/export.json",
        "song/export/hybrid.sid",
        "song/export/hybrid.prg",
        "song/native-song.writes.json",
        "song/native-song.frames.json",
        "song/native-song.schedule.json",
        "song/native-song.render.json"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "driven",
      "command": [
        "{python}",
        "scripts/native-song.py",
        "build",
        "songs/studies/bach-toccata-opening-driven/hybrid.json",
        "--output",
        "{out}/song",
        "--excerpt-seconds",
        "12"
      ],
      "inputs": [
        "scripts/native-song.py",
        "scripts/arrange-sidwizard.py",
        "scripts/generate-native-instruments.py",
        "scripts/export-sidwizard.py",
        "scripts/audio_comparison.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/sid-wizard-exporter/build.json",
        ".tools/sid-wizard-exporter/exporter.prg",
        ".tools/sid-wizard-exporter/exporter.labels",
        ".local/bin/render-sid",
        "songs/studies/bach-toccata-opening-driven/score.json",
        "songs/studies/bach-toccata-opening-driven/hybrid.json"
      ],
      "outputs": [
        "song/native-song.wav",
        "song/verification.json",
        "song/conversion.json",
        "song/export.json",
        "song/export/hybrid.sid",
        "song/export/hybrid.prg",
        "song/native-song.writes.json",
        "song/native-song.frames.json",
        "song/native-song.schedule.json",
        "song/native-song.render.json"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "driven-vice",
      "command": [
        "{python}",
        "scripts/verify-native-vice.py",
        "{stage:driven}/song/export/hybrid.prg",
        "{stage:driven}/song/native-song.writes.json",
        "--export-report",
        "{stage:driven}/song/export.json",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--calls",
        "1",
        "3",
        "100",
        "350",
        "395",
        "505",
        "606",
        "750",
        "--output",
        "{out}/vice"
      ],
      "inputs": [
        "{stage:driven}/song/export/hybrid.prg",
        "{stage:driven}/song/native-song.writes.json",
        "{stage:driven}/song/export.json",
        "scripts/verify-native-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib"
      ],
      "outputs": [
        "vice/verification.json"
      ],
      "timeoutSeconds": 90,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "sequence",
        "{stage:previous}/song/native-song.wav",
        "{stage:driven}/song/native-song.wav",
        "{out}/previous-then-driven",
        "--gap-seconds",
        "0.5"
      ],
      "inputs": [
        "{stage:previous}/song/native-song.wav",
        "{stage:driven}/song/native-song.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "previous-then-driven.ab.wav",
        "previous-then-driven.comparison.json"
      ],
      "timeoutSeconds": 30
    }
  ],
  "deliverables": {
    "previousHybrid": "{stage:previous}/song/native-song.wav",
    "drivenHybrid": "{stage:driven}/song/native-song.wav",
    "previousThenDriven": "{stage:comparison}/previous-then-driven.ab.wav",
    "drivenVerification": "{stage:driven}/song/verification.json",
    "drivenVice": "{stage:driven-vice}/vice/verification.json"
  }
}
