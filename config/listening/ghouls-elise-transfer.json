{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "prepare-check",
      "command": [
        "{python}",
        "scripts/studies/ghouls/prepare-ghouls-elise.py",
        "--check"
      ],
      "inputs": [
        "scripts/studies/ghouls/prepare-ghouls-elise.py",
        "songs/fuer-elise.json",
        "songs/ghouls.json",
        "songs/ghouls-elise-reference.json",
        "songs/ghouls-elise-transfer.json",
        "scripts/ghouls_player.py",
        "scripts/ghouls_score.py",
        "scripts/ghouls_programs.py"
      ],
      "outputs": [],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "reference-build",
      "command": [
        "{python}",
        "scripts/compose-ghouls.py",
        "songs/ghouls-elise-reference.json",
        "--output",
        "{out}/candidate"
      ],
      "inputs": [
        "songs/ghouls-elise-reference.json",
        "scripts/compose-ghouls.py",
        "scripts/ghouls_player.py",
        "scripts/ghouls_score.py",
        "scripts/ghouls_programs.py",
        "scripts/sid_assembler.py",
        "songs/players/ghouls.asm",
        "songs/players/ghouls-sound.asm",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        "scripts/ghouls_layout.py",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "candidate/reconstructed.sid",
        "candidate/reconstructed.prg",
        "candidate/verification.json",
        "candidate/audit.json",
        "candidate/writes.json",
        "candidate/state-checkpoints.json",
        "candidate/player.asm",
        "candidate/player.listing"
      ],
      "timeoutSeconds": 600,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "reference-vice",
      "command": [
        "{python}",
        "scripts/trace-sid-vice.py",
        "{stage:reference-build}/candidate/reconstructed.sid",
        "--oracle",
        "{stage:reference-build}/candidate/writes.json",
        "--first-call",
        "0",
        "--last-call",
        "716",
        "--timeout",
        "300",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--output",
        "{out}/vice",
        "--profile",
        "pal-banked",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:reference-build}/candidate/reconstructed.sid",
        "{stage:reference-build}/candidate/writes.json",
        "scripts/trace-sid-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "vice/study.json",
        "vice/trace.json",
        "vice/monitor.log",
        "vice/command.json",
        "vice/commands.mon"
      ],
      "timeoutSeconds": 330,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "reference-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:reference-build}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "14.3043611947915",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:reference-build}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-build",
      "command": [
        "{python}",
        "scripts/compose-ghouls.py",
        "songs/ghouls-elise-transfer.json",
        "--output",
        "{out}/candidate"
      ],
      "inputs": [
        "songs/ghouls-elise-transfer.json",
        "scripts/compose-ghouls.py",
        "scripts/ghouls_player.py",
        "scripts/ghouls_score.py",
        "scripts/ghouls_programs.py",
        "scripts/sid_assembler.py",
        "songs/players/ghouls.asm",
        "songs/players/ghouls-sound.asm",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        "scripts/ghouls_layout.py",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "candidate/reconstructed.sid",
        "candidate/reconstructed.prg",
        "candidate/verification.json",
        "candidate/audit.json",
        "candidate/writes.json",
        "candidate/state-checkpoints.json",
        "candidate/player.asm",
        "candidate/player.listing"
      ],
      "timeoutSeconds": 600,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-vice",
      "command": [
        "{python}",
        "scripts/trace-sid-vice.py",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "--oracle",
        "{stage:candidate-build}/candidate/writes.json",
        "--first-call",
        "0",
        "--last-call",
        "716",
        "--timeout",
        "300",
        "--data",
        ".tools/vice-headless-3.9/source/data",
        "--output",
        "{out}/vice",
        "--profile",
        "pal-banked",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{stage:candidate-build}/candidate/writes.json",
        "scripts/trace-sid-vice.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib",
        "scripts/sid_clock.py"
      ],
      "outputs": [
        "vice/study.json",
        "vice/trace.json",
        "vice/monitor.log",
        "vice/command.json",
        "vice/commands.mon"
      ],
      "timeoutSeconds": 330,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "candidate-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:candidate-build}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "14.3043611947915",
        "--subtune",
        "1"
      ],
      "inputs": [
        "{stage:candidate-build}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "signal-check",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "audio",
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "--seconds",
        "14.3043611947915",
        "--output",
        "{out}/audio.json",
        "--tail-seconds",
        "1",
        "--max-tail-ac-rms",
        "1"
      ],
      "inputs": [
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "audio.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "comparison",
      "command": [
        "{python}",
        "scripts/compare-audio.py",
        "window",
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "{out}/plain-then-ghouls",
        "--start-seconds",
        "0",
        "--end-seconds",
        "14.3043611947915",
        "--gap-seconds",
        "0.5"
      ],
      "inputs": [
        "{stage:reference-render}/render.wav",
        "{stage:candidate-render}/render.wav",
        "scripts/compare-audio.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "plain-then-ghouls.ab.wav",
        "plain-then-ghouls.comparison.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "deliverables": {
    "fullReference": "{stage:reference-render}/render.wav",
    "fullCandidate": "{stage:candidate-render}/render.wav",
    "comparison": "{stage:comparison}/plain-then-ghouls.ab.wav",
    "referenceProof": "{stage:reference-build}/candidate/verification.json",
    "candidateProof": "{stage:candidate-build}/candidate/verification.json"
  }
}
