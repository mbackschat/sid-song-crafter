  "reproduction": {
    "workingDirectory": "repository root",
    "freshOutputRequired": true,
    "outputRoot": "build/cybernoid-title-reproduce",
    "setup": "docs/workflows/audio-workflow.md",
    "pinnedRendererRequired": true,
    "commands": [
      [
        "python3",
        "scripts/setup-project.py",
        "--only",
        "references",
        "--include",
        "cybernoid-ii"
      ],
      [
        "python3",
        "scripts/prepare-cybernoid-title.py",
        "--output",
        "songs/cybernoid-title.json",
        "--check"
      ],
      [
        "python3",
        "scripts/compose-cybernoid.py",
        "songs/cybernoid-title.json",
        "--output",
        "build/cybernoid-title-reproduce/candidate"
      ],
      [
        "mkdir",
        "-p",
        "build/cybernoid-title-reproduce/reference"
      ],
      [
        ".local/bin/render-sid",
        ".local/research/cybernoid-ii/Cybernoid_II.sid",
        "build/cybernoid-title-reproduce/reference/reference.wav",
        "350"
      ],
      [
        ".local/bin/render-sid",
        "build/cybernoid-title-reproduce/candidate/reconstructed.sid",
        "build/cybernoid-title-reproduce/candidate/reconstructed.wav",
        "350"
      ],
      [
        "python3",
        "scripts/compare-audio.py",
        "window",
        "build/cybernoid-title-reproduce/reference/reference.wav",
        "build/cybernoid-title-reproduce/candidate/reconstructed.wav",
        "build/cybernoid-title-reproduce/listening/opening-reference-then-ours",
        "--start-seconds",
        "0",
        "--end-seconds",
        "24",
        "--gap-seconds",
        "0.5"
      ],
      [
        "python3",
        "scripts/compare-audio.py",
        "window",
        "build/cybernoid-title-reproduce/reference/reference.wav",
        "build/cybernoid-title-reproduce/candidate/reconstructed.wav",
        "build/cybernoid-title-reproduce/listening/ending-reference-then-ours",
        "--start-seconds",
        "334",
        "--end-seconds",
        "350",
        "--gap-seconds",
        "0.5"
      ],
      [
        "env",
        "PYTHONPATH=scripts",
        "python3",
        "-c",
        "import json\nfrom pathlib import Path\nfrom audio_comparison import Pcm16, read_pcm16, measure_pcm\nroot = Path('build/cybernoid-title-reproduce')\nmeasurements = {}\nfor role, relative in (('reference', 'reference/reference.wav'), ('candidate', 'candidate/reconstructed.wav')):\n    audio = read_pcm16(root / relative)\n    assert audio.sample_rate == 44100 and audio.channels == 1 and audio.frames == 15435000\n    tail = Pcm16(audio.sample_rate, audio.channels, audio.sample_rate, audio.samples[-audio.sample_rate * audio.channels:], '')\n    measurements[role] = {'path': str(root / relative), 'sha256': audio.sha256, 'full': measure_pcm(audio), 'lastOneSecond': {'sourceSeconds': [349, 350], **measure_pcm(tail)}}\nassert measurements['reference']['full']['clippedSamples'] == measurements['candidate']['full']['clippedSamples'] == 0\nassert measurements['candidate']['lastOneSecond']['acRms'] == 0\nwith (root / 'audio-measurements.json').open('x') as output:\n    json.dump(measurements, output, indent=2, allow_nan=False)\n    output.write('\\n')\n"
      ]
    ],
    "notes": [
      "Wait for both render commands to exit successfully before reading WAVs; each produces 15,435,000 mono PCM16 frames and a register-snapshot sidecar.",
      "The measurement command uses the same audio_comparison APIs as the retained receipt and writes a fresh audio-measurements.json.",
      "Pinned WAV and comparison PCM hashes can be checked after reproduction. JSON receipt hashes are specific to their recorded paths, so fresh output prefixes change receipt bytes."
    ]
  },
  "publication": "Original reference SID, reference WAV and A/B WAVs containing reference audio stay local under ignored .local/ or build/, never in Git or LFS. This recipe and the audio receipt retain hashes, settings, frame bounds and reproduction commands.",
  "limits": [
    "Same elapsed window copied at unity gain; no independent PCM alignment, cross-correlation, normalization, equalization or DC removal.",
    "The ending A/B intentionally compares a reference restart with the candidate's authored fade; it is not an equivalent source ending.",
    "Full render, signal health and a settled final AC tail do not establish PCM identity, SID hardware equivalence or a listening verdict.",
    "Reference WAVs and A/B WAVs containing reference material remain ignored build output and are not archived in Git or LFS."
  ]
