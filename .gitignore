# Reproducible third-party checkouts and machine-local runtime state.
.tools/
.local/
.codex/
/.mcp.json
/.claude/settings.local.json

# Generated music, dependencies, and test caches.
build/
node_modules/
__pycache__/
.pytest_cache/
.uv-cache/
.venv/

.DS_Store

# Reference tunes and unreviewed SID exports remain local.
*.[sS][iI][dD]

# Reviewed public samples with documented source and player rights.
!/samples/bach-toccata/bach-toccata.sid
!/samples/instrument-mix/instrument-mix.sid
!/samples/rambo-loader/rambo-loader.sid
!/samples/rambo-stereo/rambo-stereo.sid

# Retained verification evidence must survive a contributor's global *.log rule.
!/evidence/**/*.log

# Downloaded project-local skills; retain our skills/README.md.
/skills/c64-sid/
/skills/sid-music/

# README stereo presentations and Rambo main-entry releases.
!/samples/bach-toccata/bach-toccata-stereo.sid
!/samples/instrument-mix/instrument-mix-stereo.sid
!/samples/rambo-loader/rambo-loader-main.sid
!/samples/rambo-stereo/rambo-stereo-main.sid
