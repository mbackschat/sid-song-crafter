  "reproductionPython": "import gzip, json\nfrom pathlib import Path\nb = Path(\"evidence/billie-jean-form/complete14274\")\nrows = json.loads(gzip.decompress((b / \"rows.json.gz\").read_bytes()))\nwrites = json.loads(gzip.decompress((b / \"writes.json.gz\").read_bytes()))\nreturns = json.loads(gzip.decompress((b / \"returns.json.gz\").read_bytes()))\nprefix = [w for w in writes if w[\"phase\"] == \"init\" or w[\"tick\"] < 7106]\nlast = {w[\"address\"]: w for w in prefix}\nprint(\"prefix stores\", len(prefix), \"pre-wrap return\", returns[7105])\nfor v in range(3):\n    chosen = [r for r in rows if r[\"voice\"] == v and r[\"tick\"] < 7106]\n    print(\"physical voice\", v+1, \"last note\", next(r for r in reversed(chosen) if r[\"kind\"] == \"note\"), \"last row\", chosen[-1])\n    print({hex(a): last.get(a) for a in range(0xd400+7*v, 0xd407+7*v)})\nprint(\"filter\", {hex(a): last.get(a) for a in range(0xd415, 0xd419)})\n",
