{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "source-pin",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "asset",
        ".local/research/ghostbusters/Ghostbusters.sid",
        "--sha256",
        "f7f05616972d7fd5ad31df91284edbf4e0917d39422f8d004d50b40501a0dcde",
        "--output",
        "{out}/pin.json"
      ],
      "inputs": [
        ".local/research/ghostbusters/Ghostbusters.sid",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "pin.json"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "accepted-mono-pin",
      "command": [
        "{python}",
        "scripts/check-listening.py",
        "asset",
        "build/ghostbusters-listening/reconstructed.wav",
        "--sha256",
        "72f818806173aa93909b11739ccd5a297ca357d7c1e357d4d81252bd75032019",
        "--output",
        "{out}/pin.json"
      ],
      "inputs": [
        "build/ghostbusters-listening/reconstructed.wav",
        "scripts/check-listening.py",
        "scripts/listening_checks.py",
        "scripts/audio_comparison.py"
      ],
      "outputs": [
        "pin.json"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "complete-native",
      "command": [
        "{python}",
        "scripts/studies/ghostbusters/compile-title.py",
        "--arrangement",
        "songs/studies/ghostbusters-stereo/articulated-arrangement.json",
        "--seconds",
        "245",
        "--probe-calls",
        "14389",
        "--output",
        "{out}/candidate",
        "--vice",
        ".tools/vice-headless-3.9/build/src/x64sc",
        "--verify-source-music"
      ],
      "inputs": [
        "scripts/studies/ghostbusters/compiler.py",
        "scripts/studies/ghostbusters/player.py",
        "scripts/studies/ghostbusters/score.py",
        "scripts/studies/ghostbusters/programs.py",
        "songs/players/ghostbusters.asm",
        "scripts/sid_assembler.py",
        "scripts/psid_audit.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/sid_clock.py",
        "scripts/verify_player.py",
        ".tools/test-deps/py65",
        "evidence/ghostbusters-player/composition.json",
        "scripts/trace-sid-vice.py",
        ".tools/vice-headless-3.9/build/src/x64sc",
        ".tools/vice-headless-3.9/source/data",
        "/opt/homebrew/opt/gettext/lib/libintl.8.dylib",
        "scripts/studies/ghostbusters/compile-title.py",
        "songs/players/ghostbusters-title.asm",
        "scripts/studies/ghostbusters/speech.py",
        "scripts/studies/ghostbusters/probe-machine.py",
        "scripts/studies/ghostbusters/probe-form.py",
        "scripts/sid_intake.py",
        "scripts/reference_intake.py",
        "scripts/audio_comparison.py",
        "scripts/listening_package.py",
        ".local/research/ghostbusters/Ghostbusters.sid",
        "evidence/ghostbusters-speech-handoff/summary.json",
        "evidence/ghostbusters-components/speech/verification.json",
        "scripts/reference-intake.py",
        "scripts/listening-package.py",
        "scripts/studies/ghostbusters/stereo.py",
        "songs/studies/ghostbusters-stereo/articulated-arrangement.json"
      ],
      "outputs": [
        "candidate/reconstructed.sid",
        "candidate/reconstructed.prg",
        "candidate/private-speech.bin",
        "candidate/composition.json",
        "candidate/player.asm",
        "candidate/player.listing",
        "candidate/build.json",
        "candidate/verification.json",
        "candidate/vice.json",
        "candidate/vice-command.json",
        "candidate/commands.mon",
        "candidate/private-host.prg",
        "candidate/private-monitor.log.gz",
        "candidate/private-process.log.gz",
        "candidate/support-ledger.json"
      ],
      "timeoutSeconds": 900,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "complete-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:complete-native}/candidate/reconstructed.sid",
        "{out}/render.wav",
        "245",
        "--subtune",
        "1",
        "--clock",
        "ntsc"
      ],
      "inputs": [
        "{stage:complete-native}/candidate/reconstructed.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "support-control",
      "command": [
        "{python}",
        "scripts/studies/ghostbusters/prepare-support-control.py",
        "--candidate",
        "{stage:complete-native}/candidate/reconstructed.sid",
        "--build",
        "{stage:complete-native}/candidate/build.json",
        "--verification",
        "{stage:complete-native}/candidate/verification.json",
        "--output",
        "{out}/prepared"
      ],
      "inputs": [
        "scripts/studies/ghostbusters/prepare-support-control.py",
        "{stage:complete-native}/candidate/reconstructed.sid",
        "{stage:complete-native}/candidate/build.json",
        "{stage:complete-native}/candidate/verification.json"
      ],
      "outputs": [
        "prepared/support-disabled.sid",
        "prepared/support-disabled.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "support-control-render",
      "command": [
        "{root}/.local/bin/render-sid",
        "{stage:support-control}/prepared/support-disabled.sid",
        "{out}/render.wav",
        "245",
        "--subtune",
        "1",
        "--clock",
        "ntsc"
      ],
      "inputs": [
        "{stage:support-control}/prepared/support-disabled.sid",
        ".local/bin/render-sid",
        "scripts/render-sid.cpp",
        ".local/tools/libsidplayfp/3.1.1/lib/libsidplayfp.a"
      ],
      "outputs": [
        "render.wav",
        "render.wav.registers.tsv"
      ],
      "timeoutSeconds": 180,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "complete-listening",
      "command": [
        "{python}",
        "scripts/studies/ghostbusters/prepare-stereo-listening.py",
        "--reference",
        "build/ghostbusters-listening/reconstructed.wav",
        "--native",
        "{stage:complete-render}/render.wav",
        "--proof",
        "{stage:complete-native}/candidate/verification.json",
        "--seconds",
        "245",
        "--calls",
        "14389",
        "--output",
        "{out}/prepared",
        "--sid",
        "{stage:complete-native}/candidate/reconstructed.sid",
        "--support-disabled-render",
        "{stage:support-control-render}/render.wav"
      ],
      "inputs": [
        "scripts/studies/ghostbusters/prepare-stereo-listening.py",
        "scripts/audio_comparison.py",
        "scripts/verify_player.py",
        "build/ghostbusters-listening/reconstructed.wav",
        "{stage:complete-render}/render.wav",
        "{stage:complete-native}/candidate/verification.json",
        "{stage:complete-native}/candidate/reconstructed.sid",
        "{stage:support-control-render}/render.wav"
      ],
      "outputs": [
        "prepared/reference-duplicated-full.wav",
        "prepared/reference-matched-full.wav",
        "prepared/native-matched-full.wav",
        "prepared/native-mono-diagnostic.wav",
        "prepared/audio.json",
        "prepared/opening-mono-then-stereo.ab.wav",
        "prepared/opening-mono-then-stereo.comparison.json",
        "prepared/phrase-mono-then-stereo.ab.wav",
        "prepared/phrase-mono-then-stereo.comparison.json",
        "prepared/ending-mono-then-stereo.ab.wav",
        "prepared/ending-mono-then-stereo.comparison.json",
        "prepared/native-proof.json",
        "prepared/support-disabled-matched-phrase.wav",
        "prepared/support-enabled-matched-phrase.wav",
        "prepared/support-enabled-then-disabled-diagnostic.ab.wav",
        "prepared/support-enabled-then-disabled-diagnostic.comparison.json"
      ],
      "timeoutSeconds": 240,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "release-guards",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "-v",
        "ghostbusters_articulated_listening_test"
      ],
      "inputs": [
        "scripts/studies/ghostbusters/prepare-articulated-listening.py",
        "scripts/studies/ghostbusters/prepare-stereo-listening.py",
        "scripts/audio_comparison.py",
        "scripts/verify_player.py",
        "scripts/sid_clock.py",
        "tests/ghostbusters_articulated_listening_test.py"
      ],
      "outputs": [],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "release-check",
      "command": [
        "{python}",
        "scripts/studies/ghostbusters/prepare-articulated-listening.py",
        "--old",
        "build/ghostbusters-stereo-listening/native-stereo-matched-full.wav",
        "--native",
        "{stage:complete-render}/render.wav",
        "--disabled",
        "{stage:support-control-render}/render.wav",
        "--proof",
        "{stage:complete-native}/candidate/verification.json",
        "--sid",
        "{stage:complete-native}/candidate/reconstructed.sid",
        "--ledger",
        "{stage:complete-native}/candidate/support-ledger.json",
        "--seconds",
        "245",
        "--calls",
        "14389",
        "--output",
        "{out}/prepared"
      ],
      "inputs": [
        "scripts/studies/ghostbusters/prepare-articulated-listening.py",
        "scripts/studies/ghostbusters/prepare-stereo-listening.py",
        "scripts/audio_comparison.py",
        "scripts/verify_player.py",
        "scripts/sid_clock.py",
        "build/ghostbusters-stereo-listening/native-stereo-matched-full.wav",
        "{stage:complete-render}/render.wav",
        "{stage:support-control-render}/render.wav",
        "{stage:complete-native}/candidate/verification.json",
        "{stage:complete-native}/candidate/reconstructed.sid",
        "{stage:complete-native}/candidate/support-ledger.json"
      ],
      "outputs": [
        "prepared/initial-held-phrase.wav",
        "prepared/articulated-phrase.wav",
        "prepared/initial-then-articulated-phrase.ab.wav",
        "prepared/initial-then-articulated-phrase.comparison.json",
        "prepared/native-proof.json",
        "prepared/audio.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/tests:{root}/.tools/test-deps:{root}/scripts",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ],
  "deliverables": {
    "fullReference": "{stage:complete-listening}/prepared/reference-matched-full.wav",
    "fullCandidate": "{stage:complete-listening}/prepared/native-matched-full.wav",
    "rawReference": "{stage:complete-listening}/prepared/reference-duplicated-full.wav",
    "rawCandidate": "{stage:complete-render}/render.wav",
    "openingComparison": "{stage:complete-listening}/prepared/opening-mono-then-stereo.ab.wav",
    "phraseComparison": "{stage:complete-listening}/prepared/phrase-mono-then-stereo.ab.wav",
    "endingComparison": "{stage:complete-listening}/prepared/ending-mono-then-stereo.ab.wav",
    "signalProof": "{stage:complete-listening}/prepared/audio.json",
    "nativeProof": "{stage:complete-listening}/prepared/native-proof.json",
    "nativeBuild": "{stage:complete-native}/candidate/build.json",
    "candidateSid": "{stage:complete-native}/candidate/reconstructed.sid",
    "candidatePrg": "{stage:complete-native}/candidate/reconstructed.prg",
    "nativeVice": "{stage:complete-native}/candidate/vice.json",
    "monoDiagnostic": "{stage:complete-listening}/prepared/native-mono-diagnostic.wav",
    "supportControlProof": "{stage:support-control}/prepared/support-disabled.json",
    "supportControlComparison": "{stage:complete-listening}/prepared/support-enabled-then-disabled-diagnostic.ab.wav",
    "releaseProof": "{stage:release-check}/prepared/audio.json"
  }
}
