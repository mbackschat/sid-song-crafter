        "{python}",
        "scripts/psid_audit.py",
        "/Users/mbackschat/Projects/c64-sid-skill/.local/research/gauntlet-iii/Gauntlet_III.sid",
        "--profile",
        "pal-banked",
        "--subtune",
        "1",
        "--ticks",
        "256",
        "--output",
        "{out}/audit.json",
        "--host-base",
        "32768"
      ],
      "inputs": [
        "config/local-assets.json",
        "/Users/mbackschat/Projects/c64-sid-skill/.local/research/gauntlet-iii/Gauntlet_III.sid",
        "scripts/sid_intake.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py",
        "scripts/psid_audit.py",
        ".tools/test-deps/py65",
        "{stage:sourceA-selection}/selection.json"
      ],
      "outputs": [
        "audit.json",
        "audit.writes.json"
      ],
      "timeoutSeconds": 600,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
