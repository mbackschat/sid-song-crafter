    {
      "id": "sourceA-selection",
      "command": [
        "{python}",
        "scripts/reference-intake.py",
        "selection",
        "{{\"assetId\":\"gauntlet-iii\",\"calls\":256,\"hostBase\":32768,\"renderSeconds\":32,\"role\":\"Gauntlet III contrasting work by Tim and Geoff Follin; default source subtune 1, musical role unassigned\",\"route\":\"pal-banked\",\"subtune\":1}}",
        "--registry-sha256",
        "6485ac603b0f7d60c7dc301f5960fd1c287f9cfb9bd0fe2690846e46f0cd3397",
        "--output",
        "{out}/selection.json"
      ],
      "inputs": [
        "config/local-assets.json",
        "/Users/mbackschat/Projects/c64-sid-skill/.local/research/gauntlet-iii/Gauntlet_III.sid",
        "scripts/reference-intake.py",
        "scripts/reference_intake.py",
        "scripts/audio_comparison.py",
        "scripts/listening_package.py",
        "scripts/listening-package.py",
        "scripts/sid_intake.py",
        "scripts/psid_profile.py",
        "scripts/sid_audit_host.py",
        "scripts/verify_player.py"
      ],
      "outputs": [
        "selection.json"
      ],
      "timeoutSeconds": 120,
      "env": {
        "PYTHONPATH": "{root}/.tools/test-deps",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "id": "sourceA-audit",
